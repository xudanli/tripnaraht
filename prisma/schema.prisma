/// Match Square 3.7 — 队长投递橄榄枝（反向邀请）
model MatchSquareOliveBranchInvitation {
  id                   String   @id @default(uuid()) @db.Uuid
  postId               String   @map("post_id") @db.Uuid
  captainUserId        String   @map("captain_user_id") @db.VarChar(255)
  inviteeUserId        String   @map("invitee_user_id") @db.VarChar(255)
  status               String   @default("pending") @db.VarChar(30)
  compatibilityPercent Int      @map("compatibility_percent")
  inviteMessage        String?  @map("invite_message") @db.VarChar(500)
  radarHighlights      Json     @default("[]") @map("radar_highlights")
  respondedAt          DateTime? @map("responded_at") @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  post                 MatchSquareRecruitmentPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, inviteeUserId])
  @@index([captainUserId])
  @@index([inviteeUserId])
  @@index([status])
  @@map("match_square_olive_branch_invitations")
}

/// Reputation OS P2 — 行后 48h 互评活动（按招募帖成行组）
model ReputationSurveyCampaign {
  id               String   @id @default(uuid()) @db.Uuid
  postId           String   @unique @map("post_id") @db.Uuid
  status           String   @default("active") @db.VarChar(30)
  participantIds   Json     @map("participant_ids")
  triggerAt        DateTime @map("trigger_at") @db.Timestamptz(6)
  destinationLabel String?  @map("destination_label") @db.VarChar(255)
  tripEndDate      DateTime @map("trip_end_date") @db.Date
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  post             MatchSquareRecruitmentPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  submissions      ReputationSurveySubmission[]

  @@index([status])
  @@index([triggerAt])
  @@map("reputation_survey_campaigns")
}

/// Reputation OS P2 — 五星问卷提交（每评价人对被评价人一条）
model ReputationSurveySubmission {
  id               String   @id @default(uuid()) @db.Uuid
  campaignId       String   @map("campaign_id") @db.Uuid
  reviewerUserId   String   @map("reviewer_user_id") @db.VarChar(255)
  revieweeUserId   String   @map("reviewee_user_id") @db.VarChar(255)
  q1Overall        Int      @map("q1_overall")
  q2PaceSync       Int      @map("q2_pace_sync")
  q3Communication  Int      @map("q3_communication")
  q4Spending       Int      @map("q4_spending")
  q5WouldAgain     Int      @map("q5_would_again")
  submittedAt      DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)
  campaign         ReputationSurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, reviewerUserId, revieweeUserId])
  @@index([revieweeUserId])
  @@index([reviewerUserId])
  @@map("reputation_survey_submissions")
}

/// Reputation OS P2 — 用户信用资产聚合（脱敏展示 SSOT）
model UserReputationProfile {
