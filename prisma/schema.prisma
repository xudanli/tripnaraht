  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("data_retention_policies")
}

/// Decision OS 级执行轨迹 SSOT（在线编排 → 离线 SFT/DPO），与 PLAN_GEN 快照型 ValidatedTrajectory 正交。
model DecisionTrajectory {
  id                          String   @id @default(uuid()) @db.Uuid
  requestId                   String   @unique @map("request_id") @db.VarChar(255)
  tripId                      String?  @map("trip_id") @db.Uuid
  payload                     Json
  status                      String   @default("PENDING") @db.VarChar(20)
  totalReward                 Float?   @map("total_reward")
  rewardSignals               Json     @default("[]") @map("reward_signals")
  orchestrationOutcome        String?  @map("orchestration_outcome") @db.VarChar(32)
  legacyValidatedTrajectoryId String?  @map("legacy_validated_trajectory_id") @db.VarChar(255)
  legacyValidatedTrajectory   ValidatedTrajectory? @relation(fields: [legacyValidatedTrajectoryId], references: [trajectoryId], onDelete: SetNull)
  createdAt                   DateTime @default(now()) @map("created_at")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  @@index([tripId])
  @@index([status])
  @@index([orchestrationOutcome])
  @@map("decision_trajectories")
}

model ValidatedTrajectory {
  id                   String   @id @default(uuid()) @db.Uuid
  trajectoryId         String   @unique @map("trajectory_id") @db.VarChar(255)
  requestId            String   @map("request_id") @db.VarChar(255)
  tripId               String?  @map("trip_id") @db.Uuid
  validationStatus     String   @map("validation_status") @db.VarChar(20)
  validationScore      Float    @map("validation_score")
  validationReasons    String[] @default([]) @map("validation_reasons")
  plan                 Json
  decisionTrace        Json     @map("decision_trace")
  researchData         Json     @map("research_data")
  gateResult           Json     @map("gate_result")
  complianceResult     Json     @map("compliance_result")
  totalReward          Float    @default(0) @map("total_reward")
  rewardSignals        Json     @default("[]") @map("reward_signals")
  userApproval         String?  @map("user_approval") @db.VarChar(20)
  executionResult      Json?    @map("execution_result")
  modelVersion         String   @default("v1.0") @map("model_version") @db.VarChar(50)
  countryCode          String?  @map("country_code") @db.VarChar(2)
  timestamp            DateTime @default(now())
  usedForTraining      Boolean  @default(false) @map("used_for_training")
  trainingBatchId      String?  @map("training_batch_id") @db.VarChar(255)
  usedForTrainingCount Int      @default(0) @map("used_for_training_count")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  decisionTrajectories DecisionTrajectory[]

  @@index([validationStatus])
  @@index([validationScore])
  @@index([usedForTraining])
  @@index([countryCode, validationStatus])
  @@index([requestId])
  @@index([tripId])
  @@index([modelVersion])
  @@index([trainingBatchId])
  @@map("validated_trajectories")
}

model PlanningPlan {
  id          String   @id @default(uuid()) @db.Uuid
  tripId      String   @map("trip_id")
  planVersion Int      @default(1) @map("plan_version")
  status      String   @default("DRAFT") @db.VarChar(20)
  planState   Json     @map("plan_state")
  uiOutput    Json?    @map("ui_output")
  summary     Json?
  createdBy   String?  @map("created_by") @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  Trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

