  spatialCompleteness         Float @default(1.0) @map("spatial_completeness") // 0-1，空间完整性（空间覆盖范围）
  spatialConsistency          Float @default(1.0) @map("spatial_consistency") // 0-1，空间一致性（空间拓扑关系）

  // 标准质量维度
  completeness Float @default(1.0) // 0-1
  accuracy     Float @default(1.0) // 0-1
  consistency  Float @default(1.0) // 0-1
  timeliness   Float @default(1.0) // 0-1
  traceability Float @default(1.0) // 0-1
  overallScore Float @default(1.0) @map("overall_score") // 0-1

  // 空间查询性能
  queryLatencyP50  Float? @map("query_latency_p50") // 毫秒，P50延迟
  queryLatencyP95  Float? @map("query_latency_p95") // 毫秒，P95延迟
  queryLatencyP99  Float? @map("query_latency_p99") // 毫秒，P99延迟
  querySuccessRate Float? @default(1.0) @map("query_success_rate") // 0-1，查询成功率

  // 空间数据覆盖
  coverageRate   Float? @default(1.0) @map("coverage_rate") // 0-1，空间覆盖率
  missingRegions Json?  @map("missing_regions") // 缺失区域列表 [{ countryCode, region, featureType }]

  // 元数据
  lastUpdated  DateTime @map("last_updated")
  lastVerified DateTime @map("last_verified")
  recordCount  Int      @default(0) @map("record_count")

  // 状态
  status String @default("HEALTHY") @db.VarChar(20) // 'HEALTHY', 'WARNING', 'CRITICAL'

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  alerts DataQualityAlert[]

  @@unique([dataSource, dataType])
  @@index([countryCode])
  @@index([dataType])
  @@index([status])
  @@index([overallScore])
  @@index([coverageRate])
  @@map("geographic_data_quality_monitors")
}

// ========== Context学习结果模型 🔴 P1 新增 ==========

model ContextLearningResult {
  id String @id @default(uuid()) @db.Uuid

  // 用户和行程标识
  userId String? @map("user_id") @db.VarChar(255)
  tripId String? @map("trip_id") @db.Uuid

  // 学习事件类型
  eventType String @map("event_type") @db.VarChar(50) // 'context_built' | 'context_used' | 'decision_made' | 'user_feedback'

  // Block学习结果
  blockKey  String @map("block_key") @db.VarChar(100) // Block的唯一标识（如 'COUNTRY_WEATHER', 'PLAN_SUMMARY'）
  blockType String @map("block_type") @db.VarChar(50) // Block类型（如 'COUNTRY_WEATHER', 'PLAN_SUMMARY'）

  // 学习指标
  importanceScore       Float  @default(0.5) @map("importance_score") // 0-1，重要性评分
  relevanceScore        Float? @map("relevance_score") // 0-1，相关性评分（可选）
  usageCount            Int    @default(0) @map("usage_count") // 使用次数
  positiveFeedbackCount Int    @default(0) @map("positive_feedback_count") // 正面反馈次数
  negativeFeedbackCount Int    @default(0) @map("negative_feedback_count") // 负面反馈次数

  // 学习置信度
  confidence Float @default(0.0) @map("confidence") // 0-1，学习置信度
  sampleSize Int   @default(0) @map("sample_size") // 样本数量

  // 学习上下文
  phase     String? @db.VarChar(50) // 规划阶段（如 'PLANNING', 'EXECUTION'）
  agent     String? @db.VarChar(50) // Agent名称（如 'PlanningWorkbench', 'Gatekeeper'）
  userQuery String? @map("user_query") @db.Text // 用户查询（用于相关性学习）

  // 元数据
  metadata  Json? // 额外的学习元数据
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 注意：userId可能为空，所以不能直接用于unique约束
  // 使用组合索引代替unique约束
  @@index([userId])
  @@index([tripId])
  @@index([blockKey])
  @@index([blockType])
  @@index([eventType])
  @@index([phase])
  @@index([agent])
  @@index([importanceScore])
  @@index([confidence])
  @@index([createdAt(sort: Desc)])
  @@map("context_learning_results")
}
