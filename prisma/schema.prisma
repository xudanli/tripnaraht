  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  knowledgeVersion   ExecutionRiskKnowledgeVersion @relation(fields: [knowledgeVersionId], references: [id], onDelete: Cascade)

  @@unique([knowledgeVersionId, knowledgeCode])
  @@index([knowledgeCode])
  @@index([canonicalCode])
