  round     TripPreferenceRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  @@index([roundId])
  @@map("trip_preference_utterances")
}

/// Anonymous per-target "were you heard?" votes (F3.1)
