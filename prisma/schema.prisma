// ============================================================================
// Phase 2 Data Flywheel - 数据飞轮四层结构
// 参考: docs/PHASE2_DATA_FLYWHEEL_DESIGN.md
// ============================================================================

/// Layer 1: 决策记录 - 记录系统当时如何思考，为学习提供输入
model FlywheelDecisionLog {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  tripId          String   @map("trip_id") @db.Uuid
  decisionLogId   String?  @map("decision_log_id") @db.Uuid
  contextSnapshot Json     @map("context_snapshot")
  utilityWeights  Json     @map("utility_weights")
  candidatePlans  Json?    @map("candidate_plans")
  selectedPlan    Json?    @map("selected_plan")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([tripId])
  @@index([createdAt(sort: Desc)])
  @@map("flywheel_decision_logs")
}

/// Layer 2: 用户行为 - 用户如何修改，行为=偏好信号
model FlywheelBehaviorLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  tripId         String   @map("trip_id") @db.Uuid
  planId         String?  @map("plan_id")
  eventType      String   @map("event_type") @db.VarChar(50)
  beforeState    Json?    @map("before_state")
  afterState     Json?    @map("after_state")
  deltaDistance  Float?   @map("delta_distance")
  deltaElevation Float?   @map("delta_elevation")
  deltaTime      Int?     @map("delta_time")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([tripId])
  @@index([eventType])
  @@index([createdAt(sort: Desc)])
  @@map("flywheel_behavior_logs")
}

/// Layer 3: 结果捕捉 - 旅行结束后的真实数据
model FlywheelOutcome {
  id                 String   @id @default(uuid()) @db.Uuid
  tripId             String   @map("trip_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  subjectiveFeedback Json?    @map("subjective_feedback")
  objectiveExecution Json?    @map("objective_execution")
  failureSignals     Json?    @map("failure_signals")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([tripId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("flywheel_outcomes")
}

/// Layer 3.1: Shadow Mode audit - intervention decisions recorded without enforcing.
model ShadowDecision {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tripId     String?  @map("trip_id") @db.Uuid
  region     String?  @db.VarChar(120)
  contextKey String?  @map("context_key") @db.VarChar(80)
  capturedAt DateTime @default(now()) @map("captured_at")
  decision   Json     @map("decision")

  @@index([userId])
  @@index([tripId])
  @@index([contextKey])
  @@index([capturedAt(sort: Desc)])
  @@map("shadow_decisions")
}

/// Consensus latch (hysteresis) for distributed emergency mode, keyed by normalized contextKey.
model FlywheelConsensusLatch {
  id         String   @id @default(uuid()) @db.Uuid
  contextKey String   @unique @map("context_key") @db.VarChar(80)
  state      Json     @map("state")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([updatedAt(sort: Desc)])
  @@map("flywheel_consensus_latches")
}

/// Layer 4: 参数版本 - 学习结果版本化，支持回滚
model FlywheelParameterSet {
  id                String   @id @default(uuid()) @db.Uuid
  version           String   @db.VarChar(50)
  scope             String   @db.VarChar(20)
  scopeId           String?  @map("scope_id")
  trainingDataRange Json     @map("training_data_range")
  metrics           Json?
  weights           Json
  isActive          Boolean  @default(false) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([version, scope, scopeId])
  @@index([scope, scopeId])
  @@index([isActive])
  @@map("flywheel_parameter_sets")
}

/// 用户与参数版本绑定（当前生效）
model FlywheelUserParameterBinding {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  parameterSetId   String    @map("parameter_set_id") @db.Uuid
  parameterVersion String    @map("parameter_version") @db.VarChar(50)
  effectiveFrom    DateTime  @map("effective_from")
  effectiveTo      DateTime? @map("effective_to")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@unique([userId])
  @@index([parameterSetId])
  @@map("flywheel_user_parameter_bindings")
}

model TripRun {
  id            String        @id @default(uuid()) @db.Uuid
  tripId        String?       @map("trip_id") @db.Uuid
  userId        String?       @map("user_id") @db.Uuid
  userQuery     String        @map("user_query")
  planningPhase String        @map("planning_phase") @db.VarChar(50)
  currentAgent  String?       @map("current_agent") @db.VarChar(50)
  status        String        @default("IN_PROGRESS") @db.VarChar(20)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  completedAt   DateTime?     @map("completed_at")
  metadata      Json?
  TripAttempt   TripAttempt[]

  @@index([tripId])
  @@index([userId])
  @@index([planningPhase])
  @@index([status])
  @@index([createdAt])
  @@map("trip_runs")
}

model TripAttempt {
  id                 String    @id @default(uuid()) @db.Uuid
  tripRunId          String    @map("trip_run_id") @db.Uuid
  attemptNumber      Int       @default(1) @map("attempt_number")
  planOutline        String?   @map("plan_outline")
  openQuestions      String[]  @map("open_questions")
  constraintsAssumed String[]  @map("constraints_assumed")
  nextActions        String[]  @map("next_actions")
  failureNotes       String?   @map("failure_notes")
  status             String    @default("PENDING") @db.VarChar(20)
