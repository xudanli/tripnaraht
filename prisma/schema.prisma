  version      String    @unique @db.VarChar(50) // 'v1.0', 'v1.1'
  modelType    String    @map("model_type") @db.VarChar(50) // 'PLANNING', 'GATE', 'NARRATION'
  description  String?   @db.Text
  performance  Json? // { accuracy, latency, cost }
  trainingData Json?     @map("training_data") // 训练数据统计
  deployedAt   DateTime? @map("deployed_at")
  isActive     Boolean   @default(false) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([modelType, isActive])
  @@index([version])
  @@map("model_versions")
}

model DataQualityMonitor {
  id          String @id @default(uuid()) @db.Uuid
  dataSource  String @map("data_source") @db.VarChar(100) // 'switzerland-road-status'
  dataType    String @map("data_type") @db.VarChar(50) // 'road-status', 'ferry', 'weather'
  countryCode String @map("country_code") @db.VarChar(2)

  // 五维度质量分数
  completeness Float @default(1.0) // 0-1
  accuracy     Float @default(1.0) // 0-1
  consistency  Float @default(1.0) // 0-1
  timeliness   Float @default(1.0) // 0-1
  traceability Float @default(1.0) // 0-1
  overallScore Float @default(1.0) @map("overall_score") // 0-1

