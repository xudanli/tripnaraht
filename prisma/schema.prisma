/// Execution Risk Knowledge — versioned catalog (Package V1 SSOT after import)
model ExecutionRiskKnowledgeVersion {
  id              String   @id @db.VarChar(32)
  packageVersion  String   @map("package_version") @db.VarChar(16)
  status          String   @db.VarChar(32)
  isActive        Boolean  @default(false) @map("is_active")
