// ========== TripNARA Decision Log System ==========

// 决策日志表（用于决策体检面板）
model DecisionLog {
  id               String   @id @default(uuid()) @db.Uuid
  tripId           String?  @map("trip_id") @db.Uuid
  countryCode      String?  @map("country_code") @db.VarChar(2)
  routeDirectionId String?  @map("route_direction_id") @db.VarChar(255)
  persona          String   @db.VarChar(20) // 'ABU' | 'DR_DRE' | 'NEPTUNE'
  action           String   @db.VarChar(20) // 'ALLOW' | 'REJECT' | 'ADJUST' | 'REPLACE'
  decisionSource   String   @map("decision_source") @db.VarChar(20) // 'PHYSICAL' | 'HUMAN' | 'PHILOSOPHY' | 'HEURISTIC'
  decisionStage    String   @map("decision_stage") @db.VarChar(20) // 'ROUTE_PICK' | 'DEM_EVIDENCE' | 'ABU_GATE' | 'PACE_ADJUST' | 'SPATIAL_REPAIR' | 'READINESS' | 'FINALIZE'
  explanation      String   @db.Text
  reasonCodes      String[] @map("reason_codes")
  evidenceRefs     String[] @map("evidence_refs")
  timestamp        DateTime @default(now())
  metadata         Json?
  
  // 新增字段：决策点相关信息
  availableOptions    Json?     @map("available_options") // 可用选项
  userChoice          Json?     @map("user_choice") // 用户选择
  userReasoning       String?   @map("user_reasoning") @db.Text // 用户给出的理由
  confidenceLevel     Float?    @map("confidence_level") // 用户的信心度
  systemRecommendation Json?    @map("system_recommendation") // 系统建议
  alignmentScore      Float?    @map("alignment_score") // 系统建议与用户选择的一致性
  
  // 关联的决策结果
  outcomes            DecisionOutcome[]

  @@index([tripId])
  @@index([countryCode])
  @@index([routeDirectionId])
  @@index([decisionSource])
  @@index([decisionStage])
  @@index([persona])
  @@index([timestamp])
  @@index([countryCode, routeDirectionId, decisionSource])
  @@index([decisionStage, decisionSource])
  @@map("decision_logs")
}

model DecisionOutcome {
  id                  String   @id @default(uuid()) @db.Uuid
  decisionId          String   @map("decision_id") @db.Uuid
  expectedOutcome     Json     @map("expected_outcome")
  actualOutcome       Json     @map("actual_outcome")
  deviation           Json
  userSatisfaction    Float?   @map("user_satisfaction") // 1-10
  userFeedback        String?  @map("user_feedback") @db.Text
  learningSignals     Json     @map("learning_signals")
  createdAt           DateTime @default(now()) @map("created_at")
  
  DecisionLog         DecisionLog @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  
  @@index([decisionId])
  @@map("decision_outcomes")
}

// ========== TripNARA Agent Memory System ==========

// L1: 用户旅行人格
model UserTravelProfile {
  userId              String   @id @db.Uuid
  pacePreference      String?  @map("pace_preference") @db.VarChar(20)
  altitudeTolerance   String?  @map("altitude_tolerance") @db.VarChar(20)
  riskTolerance       String?  @map("risk_tolerance") @db.VarChar(20)
  travelPhilosophy    String?  @map("travel_philosophy") @db.VarChar(20)
  preferredRouteTypes String[] @map("preferred_route_types")
  confidence          Float    @default(0.5)
  source              String   @default("inferred") @db.VarChar(20)
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([userId])
  @@map("user_travel_profile")
}

// L2: 路线决策记忆
model RouteDirectionDecision {
  id                        String   @id @default(uuid()) @db.Uuid
  userId                    String   @map("user_id") @db.Uuid
  tripId                    String?  @map("trip_id") @db.Uuid
  countryCode               String   @map("country_code") @db.VarChar(10)
  month                     Int
  selectedRouteDirectionId  Int      @map("selected_route_direction_id")
  rejectedRouteDirectionIds Int[]    @map("rejected_route_direction_ids")
  keyConstraints            Json     @map("key_constraints")
  scoreBreakdown            Json     @map("score_breakdown")
  explanation               Json
  createdAt                 DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, countryCode])
  @@index([selectedRouteDirectionId, countryCode])
  @@map("route_direction_decision")
}

// L3: 路线健康记忆
model RouteDirectionHealth {
  routeDirectionId     Int      @map("route_direction_id")
  countryCode          String   @map("country_code") @db.VarChar(10)
  totalRuns            Int      @default(0) @map("total_runs")
  successRuns          Int      @default(0) @map("success_runs")
  failureRuns          Int      @default(0) @map("failure_runs")
  commonFailureReasons String[] @map("common_failure_reasons")
  commonRepairs        String[] @map("common_repairs")
  lastUpdated          DateTime @default(now()) @updatedAt @map("last_updated")

  @@id([routeDirectionId, countryCode])
  @@index([routeDirectionId, countryCode])
  @@map("route_direction_health")
}

// L4: 行为反馈记忆
model TripOutcomeFeedback {
  tripId         String   @id @map("trip_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  overallSuccess Boolean  @map("overall_success")
  fatigueLevel   Int?     @map("fatigue_level")
  satisfaction   Int?     @map("satisfaction")
  abandoned      Boolean  @default(false)
  failurePoints  String[] @map("failure_points")
  notes          String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([tripId])
  @@map("trip_outcome_feedback")
}

// ========== TripNARA Context Engineer System ==========

// TripRun: 一次规划会话（用户点击"生成路线"）
model TripRun {
  id              String        @id @default(uuid()) @db.Uuid
  tripId          String?       @map("trip_id") @db.Uuid
  userId          String?       @map("user_id") @db.Uuid
  userQuery       String        @map("user_query") @db.Text
  planningPhase   String        @map("planning_phase") @db.VarChar(50)
  currentAgent    String?       @map("current_agent") @db.VarChar(50)
  status          String        @default("IN_PROGRESS") @db.VarChar(20) // IN_PROGRESS, COMPLETED, FAILED
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  completedAt     DateTime?     @map("completed_at")
  metadata        Json?
  
  TripAttempt     TripAttempt[]
  
  @@index([tripId])
  @@index([userId])
  @@index([planningPhase])
  @@index([status])
  @@index([createdAt])
  @@map("trip_runs")
}

// TripAttempt: 一次候选方案（plan candidate）的迭代
model TripAttempt {
  id              String        @id @default(uuid()) @db.Uuid
  tripRunId       String        @map("trip_run_id") @db.Uuid
  attemptNumber   Int           @default(1) @map("attempt_number")
  
  // Scratchpad（工作计划摘要）
  planOutline     String?       @map("plan_outline") @db.Text // 要做什么
  openQuestions   String[]      @map("open_questions") // 缺什么信息
  constraintsAssumed String[]   @map("constraints_assumed") // 假设了哪些约束
  nextActions     String[]      @map("next_actions") // 下一步要调用哪些 tools / skills
  failureNotes    String?       @map("failure_notes") @db.Text // 失败原因摘要
  
  // 状态
  status          String        @default("PENDING") @db.VarChar(20) // PENDING, IN_PROGRESS, COMPLETED, FAILED
  resultSummary   String?       @map("result_summary") @db.Text
  artifacts       Json? // 结构化结果引用（文件路径、ID等）
  
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  completedAt     DateTime?     @map("completed_at")
  metadata        Json?
  
  TripRun         TripRun       @relation(fields: [tripRunId], references: [id], onDelete: Cascade)
  
  @@unique([tripRunId, attemptNumber]) // 复合唯一键：一个 run 的同一 attemptNumber 只能有一个
  @@index([tripRunId])
  @@index([status])
  @@index([attemptNumber])
  @@index([createdAt])
  @@map("trip_attempts")
}

// ========== TripNARA RAG System ==========

// 文档索引表（用于存储 Rail Pass 条款、游记、攻略等）
model DocumentIndex {
  id          String                 @id @default(uuid()) @db.Uuid
  collection  String                 @db.VarChar(50) // 'rail_pass_rules' | 'travel_guides' | 'local_insights'
  title       String                 @db.VarChar(255)
  content     String                 @db.Text
  embedding   Unsupported("vector")? // pgvector embedding
  source      String?                @db.VarChar(255) // 来源 URL 或文件名
  countryCode String?                @map("country_code") @db.VarChar(2)
  tags        String[] // 标签，如 ['eurail', 'iceland', 'f-road']
  metadata    Json? // 额外元数据
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @default(now()) @updatedAt @map("updated_at")

  @@index([collection])
  @@index([countryCode])
  @@index([tags])
  @@map("document_index")
}

// 合规证据表（从 RAG 提取的结构化规则）
model ComplianceEvidence {
  id           String    @id @default(uuid()) @db.Uuid
  countryCode  String    @map("country_code") @db.VarChar(2)
  ruleType     String    @map("rule_type") @db.VarChar(50) // 'RAIL_PASS' | 'TRAIL_ACCESS' | 'PERMIT_REQUIREMENT'
  ruleData     Json      @map("rule_data") // 结构化规则对象（RailPassRule / TrailAccessRule / PermitRequirement）
  source       String    @default("RAG_EXTRACTED") @db.VarChar(50) // 'RAG_EXTRACTED' | 'MANUAL' | 'API'
  sourceUrl    String?   @map("source_url") @db.VarChar(500)
  confidence   String    @default("MEDIUM") @db.VarChar(20) // 'HIGH' | 'MEDIUM' | 'LOW'
  extractedAt  DateTime  @default(now()) @map("extracted_at")
  lastVerified DateTime? @map("last_verified")
  isValid      Boolean   @default(true) @map("is_valid")
  metadata     Json?

  @@index([countryCode])
  @@index([ruleType])
  @@index([countryCode, ruleType])
  @@map("compliance_evidence")
}

// 当地洞察表（软知识，不参与硬决策）
model LocalInsight {
  id               String   @id @default(uuid()) @db.Uuid
  countryCode      String   @map("country_code") @db.VarChar(2)
  region           String?  @db.VarChar(100)
  tags             String[] // ['alpine_hut', 'wild_camp', 'f_road', 'public_transport']
  content          String   @db.Text // LLM 基于 RAG 生成的小段文字
  evidenceSnippets String[] @map("evidence_snippets") // 原文引用片段
  confidence       String   @default("MEDIUM") @db.VarChar(20) // 'HIGH' | 'MEDIUM' | 'LOW'
  source           String?  @db.VarChar(255) // 来源 URL
  lastUpdated      DateTime @default(now()) @updatedAt @map("last_updated")
  createdAt        DateTime @default(now()) @map("created_at")
  metadata         Json?

  @@index([countryCode])
  @@index([tags])
  @@index([countryCode, tags])
  @@map("local_insight")
}

