/// Match Square P0 — 搭子广场招募帖（结构化 listing，与盲盒 MatchmakingBlindListing 独立）
model MatchSquareRecruitmentPost {
  id                     String    @id @default(uuid()) @db.Uuid
  captainUserId          String    @map("captain_user_id") @db.VarChar(255)
  status                 String    @default("active") @db.VarChar(30)
  destination            String    @db.VarChar(255)
  departureLabel         String?   @map("departure_label") @db.VarChar(255)
  destinationLat         Float?    @map("destination_lat")
  destinationLng         Float?    @map("destination_lng")
  destinationPoiId       String?   @map("destination_poi_id") @db.VarChar(255)
  startDate              DateTime  @map("start_date") @db.Date
  endDate                DateTime  @map("end_date") @db.Date
  itinerarySummary       String    @map("itinerary_summary") @db.VarChar(500)
  budgetMinCents         Int?      @map("budget_min_cents")
  budgetMaxCents         Int?      @map("budget_max_cents")
  slotsNeeded            Int       @map("slots_needed")
  slotsFilled            Int       @default(0) @map("slots_filled")
  preferenceNotes        String?   @map("preference_notes") @db.Text
  tripMoodTag            String?   @map("trip_mood_tag") @db.VarChar(30)
  planningStyle          String?   @map("planning_style") @db.VarChar(30)
  travelMode             String?   @map("travel_mode") @db.VarChar(30)
  vehicleInfo            String?   @map("vehicle_info") @db.VarChar(500)
  captainMessage         String?   @map("captain_message") @db.VarChar(500)
  captainMbtiType        String    @map("captain_mbti_type") @db.VarChar(8)
  captainCardTitle       String    @map("captain_card_title") @db.VarChar(255)
  captainInteractionMode String    @map("captain_interaction_mode") @db.VarChar(50)
  captainReputationStars Float?    @map("captain_reputation_stars")
  captainPersonaSnapshot Json      @map("captain_persona_snapshot")
  publishedAt            DateTime? @map("published_at") @db.Timestamptz(6)
  closedAt               DateTime? @map("closed_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([destination])
  @@index([startDate, endDate])
  @@index([captainUserId])
  @@index([captainMbtiType])
  @@index([captainInteractionMode])
  @@index([planningStyle])
  @@map("match_square_recruitment_posts")
  applications MatchSquareRecruitmentApplication[]
  reputationCampaigns ReputationSurveyCampaign[]
  oliveBranchInvitations MatchSquareOliveBranchInvitation[]
}

/// Match Square P1 — 招募申请（队员视角提交，队长审批）
model MatchSquareRecruitmentApplication {
  id                         String   @id @default(uuid()) @db.Uuid
  postId                     String   @map("post_id") @db.Uuid
  applicantUserId            String   @map("applicant_user_id") @db.VarChar(255)
  status                     String   @default("pending") @db.VarChar(30)
  message                    String   @db.VarChar(200)
  planningCommitmentAccepted Boolean  @default(false) @map("planning_commitment_accepted")
  teamworkCommitmentAccepted Boolean  @default(false) @map("teamwork_commitment_accepted")
  applicantDisplayName       String?  @map("applicant_display_name") @db.VarChar(255)
  applicantMbtiType          String   @map("applicant_mbti_type") @db.VarChar(8)
  applicantCardTitle         String   @map("applicant_card_title") @db.VarChar(255)
  applicantInteractionMode   String   @map("applicant_interaction_mode") @db.VarChar(50)
  applicantReputationStars   Float?   @map("applicant_reputation_stars")
  applicantPersonaSnapshot   Json     @map("applicant_persona_snapshot")
  compatibilityPercent       Int      @map("compatibility_percent")
  matchHighlights            Json     @default("[]") @map("match_highlights")
  matchWarnings              Json     @default("[]") @map("match_warnings")
  targetSlotIndex            Int?     @map("target_slot_index")
  targetSlotId               String?  @map("target_slot_id") @db.VarChar(64)
  targetSlotLabel            String?  @map("target_slot_label") @db.VarChar(255)
  decidedAt                  DateTime? @map("decided_at") @db.Timestamptz(6)
  createdAt                  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  post                       MatchSquareRecruitmentPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([applicantUserId])
  @@index([status])
  @@map("match_square_recruitment_applications")
}

/// Match Square 3.7 — 队员挂起旅行意向（反向撮合信号）
model MatchSquareTravelIntent {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.VarChar(255)
  status           String   @default("active") @db.VarChar(30)
  destinationScope String   @map("destination_scope") @db.VarChar(255)
  startDate        DateTime @map("start_date") @db.Date
  endDate          DateTime @map("end_date") @db.Date
  budgetFlex       String   @default("flexible") @map("budget_flex") @db.VarChar(30)
  openToCarpool    Boolean  @default(true) @map("open_to_carpool")
  note             String?  @db.VarChar(500)
  capabilityTags   Json     @default("[]") @map("capability_tags")
  personaSnapshot  Json     @map("persona_snapshot")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

