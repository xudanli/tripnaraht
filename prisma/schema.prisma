  tripId      String           @map("trip_id")
  domain      String           @db.VarChar(32)
  claimUserId String           @map("claim_user_id") @db.Text
  endorserId  String           @map("endorser_id") @db.Text
  claimId     String?          @map("claim_id") @db.Uuid
