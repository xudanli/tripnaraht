  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([validationStatus])
  @@index([validationScore])
  @@index([usedForTraining])
  @@index([countryCode, validationStatus])
  @@index([requestId])
  @@index([tripId])
  @@index([modelVersion])
  @@index([trainingBatchId])
  @@map("validated_trajectories")
}

