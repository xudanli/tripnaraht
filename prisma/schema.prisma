// ===== 知识库文件表 =====
model KnowledgeFile {
  id       String @id @default(uuid()) @db.Uuid
  filename String @unique @db.VarChar(255)
  filepath String @db.VarChar(500)
  category String @db.VarChar(50) // practical_guides, decision_support, safety, etc.
  version  String @db.VarChar(20)
  language String @default("zh-CN") @db.VarChar(10)

  credibilityScore Float    @map("credibility_score")
  dataSources      String[] @map("data_sources")
  lastUpdated      DateTime @map("last_updated")

  chunks Chunk[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([filename])
  @@map("knowledge_files")
}

// ===== 文档分块表 =====
model Chunk {
  id      String @id @default(uuid()) @db.Uuid
  chunkId String @unique @map("chunk_id") @db.VarChar(255) // rhythm_pattern_relaxed_001

  content String @db.Text

  // pgvector 向量字段 (1536维度 - OpenAI text-embedding-3-small)
  embedding Unsupported("vector(1536)")?

  // 元数据
  type             String   @db.VarChar(50) // rhythm_pattern, legal_rule, operational_guide, etc.
  section          String?  @db.VarChar(100)
  credibilityScore Float    @map("credibility_score")
  keywords         String[]

  // 关联
  fileId String        @map("file_id") @db.Uuid
  file   KnowledgeFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  // 附加元数据（JSON）
  metadata Json?

  tokenCount Int? @map("token_count")

  // RAG 架构扩展字段
  lastVerifiedAt DateTime? @map("last_verified_at") @db.Timestamptz
  category       String? // RULES, POI_HOURS, POI_INFO, GATE, WEATHER, GENERAL

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([credibilityScore])
  @@index([fileId])
  @@index([category])
  @@index([lastVerifiedAt])
  @@index([category, lastVerifiedAt(sort: Desc)])
  @@map("chunks")
}

// ===== 关键词索引表（辅助检索）=====
model KeywordIndex {
  id      String   @id @default(uuid()) @db.Uuid
  keyword String   @unique @db.VarChar(100)
  files   String[] // 相关文件列表

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("keyword_indices")
}

