  @@index([tripRunId])
  @@index([status])
  @@index([attemptNumber])
  @@index([createdAt])
  @@map("trip_attempts")
}

model KnowledgeFile {
  id               String   @id @default(uuid()) @db.Uuid
  filename         String   @unique @db.VarChar(255)
  filepath         String   @db.VarChar(500)
  /// 文档集合：六类 canonical（decision-support | geography | pois | practical | risks | routes）或迁移期旧值
  category         String   @db.VarChar(50)
  /// 业务子类型 slug（与 category 组合校验）；迁移前可为空
  subType          String?  @map("sub_type") @db.VarChar(64)
  version          String   @db.VarChar(20)
  language         String   @default("zh-CN") @db.VarChar(10)
  credibilityScore Float    @map("credibility_score")
  dataSources      String[] @map("data_sources")
  /// 管理端：国家/地区代码（如 IS、CN），可选
  countryCode      String?  @map("country_code") @db.VarChar(16)
  /// 管理端：来源说明，可选
  source           String?  @map("source") @db.VarChar(500)
  /// 管理端：扩展 JSON（与 RAG Update API metadata 对齐）
  adminMetadata    Json?    @map("admin_metadata")
  lastUpdated      DateTime @map("last_updated")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  chunks           Chunk[]

  @@index([category])
  @@index([category, subType])
  @@index([filename])
  @@map("knowledge_files")
}

model Chunk {
  id               String                 @id @default(uuid()) @db.Uuid
  chunkId          String                 @unique @map("chunk_id") @db.VarChar(255)
  content          String
  type             String                 @db.VarChar(50)
  section          String?                @db.VarChar(100)
  credibilityScore Float                  @map("credibility_score")
  keywords         String[]
  fileId           String                 @map("file_id") @db.Uuid
  metadata         Json?
  tokenCount       Int?                   @map("token_count")
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")
  category         String?
  lastVerifiedAt   DateTime?              @map("last_verified_at") @db.Timestamptz(6)
  embedding        Unsupported("vector")?
  file             KnowledgeFile          @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([credibilityScore])
  @@index([fileId])
  @@index([category])
  @@index([lastVerifiedAt])
  @@index([category, lastVerifiedAt(sort: Desc)])
  @@map("chunks")
}

model KeywordIndex {
  id        String   @id @default(uuid()) @db.Uuid
  keyword   String   @unique @db.VarChar(100)
  files     String[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("keyword_indices")
}

model QueryHistory {
