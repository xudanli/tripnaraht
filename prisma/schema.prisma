  decisionTrace    Json @map("decision_trace") // DecisionLogEntry[]
  researchData     Json @map("research_data")
  gateResult       Json @map("gate_result") // GateResult
  complianceResult Json @map("compliance_result") // ComplianceResult

  // Reward信号
  totalReward   Float @default(0) @map("total_reward")
  rewardSignals Json  @default("[]") @map("reward_signals") // RewardSignal[]

