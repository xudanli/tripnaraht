/// Append-only negotiation / confirm snapshots for audit + rollback (no FK to Trip — trip_id is logical).
model ItineraryRevision {
  id                     String   @id @default(uuid())
  tripId                 String?  @map("trip_id")
  userId                 String?  @map("user_id")
  parentRevisionId       String?  @map("parent_revision_id")
  negotiationSessionId   String?  @map("negotiation_session_id")
  alternativeId          String?  @map("alternative_id")
  resolutionPatchSummary String?  @map("resolution_patch_summary")
  snapshot               Json
  /// BASELINE | CONFIRMED | ROLLBACK (append-only rollback hop).
  kind                   String   @default("CONFIRMED")
  createdAt              DateTime @default(now()) @map("created_at")

  /// Structured audit delta (V_n → V_{n+1}); unset on BASELINE rows.
  deltaCostUsd     Float?  @map("delta_cost_usd")
  deltaTimeMinutes Int?    @map("delta_time_minutes")
  interruptedItems Json?   @map("interrupted_items")
  resolutionType   String? @map("resolution_type")

  parent   ItineraryRevision?  @relation("ItineraryRevisionChain", fields: [parentRevisionId], references: [id], onDelete: SetNull)
  children ItineraryRevision[] @relation("ItineraryRevisionChain")

  @@index([tripId, createdAt])
  @@index([negotiationSessionId])
  @@index([parentRevisionId])
  @@index([tripId, deltaTimeMinutes])
  @@map("itinerary_revisions")
}

