// ─── Guide-to-Plan Pipeline（从攻略开始规划）────────────────────────────────

/// 攻略导入会话：可累积多篇攻略，经理解确认后再生成行程草案
model GuideToPlanSession {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @map("user_id") @db.Uuid
  /// collecting | parsing | understanding | awaiting_context | generating | draft_ready | accepted | abandoned
  status               String   @default("collecting") @db.VarChar(32)
  countryCode          String?  @map("country_code") @db.VarChar(8)
  destination          String?  @db.VarChar(200)
  /// 用户确认的出行条件：日期、成员、交通、保留体验等
  travelContext        Json?    @map("travel_context")
  /// 合并多篇攻略后的理解摘要（地点数、主线、风险等）
  understandingSummary Json?    @map("understanding_summary")
  themeNarrative       String?  @map("theme_narrative") @db.Text
  /// 接受草案后关联的正式 Trip
  tripId               String?  @map("trip_id")
  /// 异步解析进度（步骤、百分比、实时计数、三人格思考）
  parseProgress        Json?    @map("parse_progress")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  Trip             Trip?                      @relation(fields: [tripId], references: [id], onDelete: SetNull)
  importedGuides   ImportedGuide[]
  claims           GuideClaim[]
  candidates       GuideInspirationCandidate[]
  planCandidates   GuidePlanCandidate[]

  @@index([userId, status])
  @@index([tripId])
  @@map("guide_to_plan_sessions")
}

/// 单篇攻略导入单元
model ImportedGuide {
  id               String    @id @default(uuid()) @db.Uuid
  sessionId        String    @map("session_id") @db.Uuid
  title            String?   @db.VarChar(500)
  /// link | screenshot | text | file | manual
  sourceType       String    @map("source_type") @db.VarChar(16)
  sourceUrl        String?   @map("source_url") @db.Text
  /// xiaohongshu | douyin | wechat | blog | unknown
  sourcePlatform   String?   @map("source_platform") @db.VarChar(32)
  rawContent       String?   @map("raw_content") @db.Text
  ocrText          String?   @map("ocr_text") @db.Text
  imageUrl         String?   @map("image_url") @db.Text
  /// 文件/链接元数据：fileName, mimeType, sizeBytes, pageCount, wordCount, author
  sourceMetadata   Json?     @map("source_metadata")
  /// pending | parsing | parsed | failed
  parseStatus      String    @default("pending") @map("parse_status") @db.VarChar(16)
  /// 0–1，攻略来源默认可信度偏低
  sourceConfidence Float     @default(0.3) @map("source_confidence")
  /// L1–L5 信息可信度等级
  credibilityLevel String    @default("L1") @map("credibility_level") @db.VarChar(4)
  extractedPlaces  Json?     @map("extracted_places")
  extractedRoutes  Json?     @map("extracted_routes")
  extractedTips    Json?     @map("extracted_tips")
  implicitAssumptions Json?  @map("implicit_assumptions")
  parseError       String?   @map("parse_error") @db.Text
  importedAt       DateTime  @default(now()) @map("imported_at") @db.Timestamptz(6)
  parsedAt         DateTime? @map("parsed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  session GuideToPlanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  claims  GuideClaim[]

  @@index([sessionId, parseStatus])
  @@map("imported_guides")
}

/// 攻略作者经验/主张（≠ 官方事实 ≠ 可直接执行的硬约束）
model GuideClaim {
  id                 String   @id @default(uuid()) @db.Uuid
  sessionId          String   @map("session_id") @db.Uuid
  guideId            String?  @map("guide_id") @db.Uuid
  claimType          String   @map("claim_type") @db.VarChar(64)
  subjectType        String?  @map("subject_type") @db.VarChar(32)
  subjectId          String?  @map("subject_id") @db.Text
  subjectName        String?  @map("subject_name") @db.VarChar(200)
  statement          String   @db.Text
  source             String   @default("guide_author") @db.VarChar(32)
  confidenceLevel    String   @default("L1") @map("confidence_level") @db.VarChar(4)
  applicableSeason   String?  @map("applicable_season") @db.VarChar(32)
  applicableTraveler String?  @map("applicable_traveler") @db.VarChar(64)
  /// unverified | partially_verified | verified | contradicted
  verificationStatus String   @default("unverified") @map("verification_status") @db.VarChar(32)
  metadata           Json?
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session GuideToPlanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  guide   ImportedGuide?     @relation(fields: [guideId], references: [id], onDelete: SetNull)

  @@index([sessionId, claimType])
  @@index([guideId])
  @@map("guide_claims")
}

/// 攻略提取的灵感候选（POI / 餐厅 / 住宿 / 活动 / 路线主题）
model GuideInspirationCandidate {
  id               String   @id @default(uuid()) @db.Uuid
  sessionId        String   @map("session_id") @db.Uuid
  sourceGuideIds   String[] @default([]) @map("source_guide_ids") @db.Uuid
  /// poi | restaurant | hotel | activity | route_theme
  candidateType    String   @map("candidate_type") @db.VarChar(32)
  rawName          String   @map("raw_name") @db.VarChar(200)
  rawNameEn        String?  @map("raw_name_en") @db.VarChar(200)
  placeId          Int?     @map("place_id")
  /// unmatched | matched | ambiguous | rejected
  matchStatus      String   @default("unmatched") @map("match_status") @db.VarChar(16)
  suggestedDay     Int?     @map("suggested_day")
  routeOrder       Int?     @map("route_order")
  priority         String   @default("medium") @db.VarChar(16)
  sourceConfidence Float    @default(0.3) @map("source_confidence")
  /// L1 author opinion | L2 cross-guide | L3 POI matched | L4/L5 reserved
  credibilityLevel String   @default("L1") @map("credibility_level") @db.VarChar(4)
  metadata         Json?
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session GuideToPlanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, candidateType])
  @@index([sessionId, matchStatus])
  @@index([sessionId, credibilityLevel])
  @@map("guide_inspiration_candidates")
}

/// 经三人格审议后生成的行程草案（非正式可执行计划，直到用户接受）
model GuidePlanCandidate {
  id              String   @id @default(uuid()) @db.Uuid
  sessionId       String   @map("session_id") @db.Uuid
  /// balanced | faithful | comfortable | risk_min | photography
  variant         String   @default("balanced") @db.VarChar(32)
  /// draft | verified | accepted | rejected
  status          String   @default("draft") @db.VarChar(16)
  sourceGuideIds  String[] @default([]) @map("source_guide_ids") @db.Uuid
  retainedItems   Json     @default("[]") @map("retained_items")
  modifiedItems   Json     @default("[]") @map("modified_items")
  rejectedItems   Json     @default("[]") @map("rejected_items")
  decisionReasons Json     @default("[]") @map("decision_reasons")
  comparisonDiff  Json?    @map("comparison_diff")
  personaOpinions Json?    @map("persona_opinions")
  itineraryDraft  Json?    @map("itinerary_draft")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  session GuideToPlanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@map("guide_plan_candidates")
}

/// Consumer Exploration — 探索规划会话（Scenario → Trip 物化）
model ExplorationScenario {
  id                 String    @id @default(uuid()) @db.Uuid
  /// RFC-003 V1: stable Travel Context identity (defaults to scenario id at creation)
  contextId          String    @unique @map("context_id") @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  /// DRAFT | MATERIALIZING | MATERIALIZED | COMPLETED | ABANDONED
  status             String    @default("DRAFT") @db.VarChar(32)
  researchProtocolId String?   @map("research_protocol_id") @db.VarChar(64)
  participantCode    String?   @map("participant_code") @db.VarChar(64)
  initialInput       Json      @map("initial_input")
  assignedVariant    String?   @map("assigned_variant") @db.VarChar(32)
  tripId             String?   @map("trip_id")
  materializedAt     DateTime? @map("materialized_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  Trip            Trip?                      @relation(fields: [tripId], references: [id], onDelete: SetNull)
  researchSession ProductDiscoverySession?
  routeVariants   ExplorationRouteVariant[]

  @@index([userId, status])
  @@index([tripId])
  @@map("exploration_scenarios")
}

/// RFC-003 Phase 5+ — append-only Travel Context revision diff journal (survives process restart).
model TravelContextRevisionJournalEntry {
  id             String   @id @default(uuid()) @db.Uuid
  contextId      String   @map("context_id") @db.VarChar(64)
  fromRevision   BigInt   @map("from_revision")
  toRevision     BigInt   @map("to_revision")
  snapshotId     String?  @map("snapshot_id") @db.VarChar(128)
  changedDomains Json     @map("changed_domains")
  changes        Json
  intentType     String?  @map("intent_type") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([contextId, fromRevision, toRevision])
  @@index([contextId, fromRevision])
  @@index([contextId, toRevision(sort: Desc)])
  @@map("travel_context_revision_journal")
}

/// RFC-003 Phase 7 — point-in-time Travel Context snapshot archive (audit replay + cold-start cache).
model TravelContextSnapshotArchiveEntry {
  id                  String   @id @default(uuid()) @db.Uuid
  contextId           String   @map("context_id") @db.VarChar(64)
  revision            BigInt
  snapshotId          String   @map("snapshot_id") @db.VarChar(128)
  schemaId            String   @map("schema_id") @db.VarChar(64)
  stage               String   @db.VarChar(32)
  snapshot            Json
  bindingsFingerprint String   @map("bindings_fingerprint") @db.VarChar(256)
  archiveSource       String   @map("archive_source") @db.VarChar(32)
  intentType          String?  @map("intent_type") @db.VarChar(64)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([contextId, revision])
  @@index([contextId, createdAt(sort: Desc)])
  @@map("travel_context_snapshot_archive")
}

/// 产品发现研究 Session（与 ExplorationScenario 1:1）
model ProductDiscoverySession {
  id              String    @id @default(uuid()) @db.Uuid
  scenarioId      String    @unique @map("scenario_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  participantCode String?   @map("participant_code") @db.VarChar(64)
  protocolId      String    @map("protocol_id") @db.VarChar(64)
  entryVariant    String?   @map("entry_variant") @db.VarChar(32)
  metadata        Json?
  startedAt       DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt     DateTime? @map("completed_at") @db.Timestamptz(6)

  scenario ExplorationScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  events       ResearchEvent[]
  commitments  ProductDiscoveryCommitment[]
  contactInfo  ResearchContactInfo?
  packageFeedback ProductDiscoveryPackageFeedback?
  paymentRecords  ResearchPaymentRecord[]

  @@index([userId])
  @@index([protocolId])
  @@map("product_discovery_sessions")
}

/// 研究行为事件（批量上报）
model ResearchEvent {
  id         String   @id @default(uuid()) @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  eventName  String   @map("event_name") @db.VarChar(64)
  payload    Json     @default("{}")
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  session ProductDiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, occurredAt])
  @@map("research_events")
}

/// 研究商品包装反馈（排序 / 评分 / 价格 — 非 PII）
model ProductDiscoveryPackageFeedback {
  id                    String   @id @default(uuid()) @db.Uuid
  sessionId             String   @unique @map("session_id") @db.Uuid
  presentationOrder     Json     @map("presentation_order")
  packageRankings       Json     @map("package_rankings")
  valueScores           Json     @map("value_scores")
  trustScores           Json     @map("trust_scores")
  acceptablePriceUsd    Json?    @map("acceptable_price_usd")
  leastPreferredPackageId String? @map("least_preferred_package_id") @db.VarChar(64)
  preferredPackageId    String?  @map("preferred_package_id") @db.VarChar(64)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  session ProductDiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("product_discovery_package_feedback")
}

/// 研究行为承诺（NOTIFY_ME / SELF_CHECK；4B: DEPOSIT / PRICE_LOCK）
model ProductDiscoveryCommitment {
  id             String   @id @default(uuid()) @db.Uuid
  sessionId      String   @map("session_id") @db.Uuid
  commitmentType String   @map("commitment_type") @db.VarChar(32)
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  session ProductDiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, commitmentType])
  @@map("product_discovery_commitments")
}

/// 研究联系方式（PII 分表）
model ResearchContactInfo {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @unique @map("session_id") @db.Uuid
  email     String?  @db.VarChar(320)
  phone     String?  @db.VarChar(32)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  session ProductDiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("research_contact_info")
}

/// 研究支付记录（订金 / 价格锁定 — 与正式支付共用 Stripe，独立 SKU）
model ResearchPaymentRecord {
  id                    String    @id @default(uuid()) @db.Uuid
  sessionId             String    @map("session_id") @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  /// RESEARCH_DEPOSIT | RESEARCH_PRICE_LOCK
  paymentKind           String    @map("payment_kind") @db.VarChar(32)
  skuId                 String    @map("sku_id") @db.VarChar(64)
  amountCents           Int       @default(0) @map("amount_cents")
  currency              String    @default("usd") @db.VarChar(3)
  /// PENDING | REQUIRES_ACTION | SUCCEEDED | REFUNDED | CANCELLED
  status                String    @default("PENDING") @db.VarChar(32)
  stripePaymentIntentId String?   @unique @map("stripe_payment_intent_id") @db.VarChar(128)
  clientSecret          String?   @map("client_secret") @db.VarChar(256)
  priceLockUsd          Int?      @map("price_lock_usd")
  refundedAt            DateTime? @map("refunded_at") @db.Timestamptz(6)
  metadata              Json?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  session ProductDiscoverySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, paymentKind])
  @@index([userId])
  @@map("research_payment_records")
}

/// 单 Trip 下的路线 variant branch（一 Scenario 一 Trip，多 variant）
model ExplorationRouteVariant {
  id                String   @id @default(uuid()) @db.Uuid
  scenarioId        String   @map("scenario_id") @db.Uuid
  tripId            String   @map("trip_id")
  routeId           String   @map("route_id") @db.VarChar(64)
  strategyId        String   @map("strategy_id") @db.VarChar(64)
  variantBranchKey  String   @map("variant_branch_key") @db.VarChar(64)
  itineraryVersion  Int      @default(1) @map("itinerary_version")
  /// DRAFT | SELECTED | ARCHIVED
  status            String   @default("DRAFT") @db.VarChar(16)
  title             String?  @db.VarChar(200)
  narrative         String?  @db.Text
  metrics           Json?
  gains             Json?
  sacrifices        Json?
  generationVersion Int      @default(1) @map("generation_version")
  /// STATIC_CATALOG | PERSONALIZED | ENGINE_MAPBOX | LLM
  generationSource  String?  @map("generation_source") @db.VarChar(32)
  routeDetail       Json?    @map("route_detail")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  scenario ExplorationScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, routeId])
  @@index([tripId])
  @@map("exploration_route_variants")
}

/// Task E0 — Append-only shadow comparison evidence (Authority vs Lex shadow dual-run).
model DecisionShadowComparison {
  id                            String   @id @default(uuid()) @db.Uuid
  comparisonId                  String   @unique @map("comparison_id") @db.VarChar(128)
  decisionRunId                 String   @map("decision_run_id") @db.VarChar(256)
  tripId                        String   @map("trip_id") @db.VarChar(128)
  snapshotId                    String   @map("snapshot_id") @db.VarChar(128)
  snapshotHash                  String   @map("snapshot_hash") @db.VarChar(64)
  candidateSetHash              String   @map("candidate_set_hash") @db.VarChar(64)
  constraintReportHash          String   @map("constraint_report_hash") @db.VarChar(64)
  objectiveConfigHash           String   @map("objective_config_hash") @db.VarChar(64)
  authorityStrategyId           String   @map("authority_strategy_id") @db.VarChar(64)
  authorityStrategyVersion      String?  @map("authority_strategy_version") @db.VarChar(32)
  shadowStrategyId              String   @map("shadow_strategy_id") @db.VarChar(64)
  shadowStrategyVersion         String?  @map("shadow_strategy_version") @db.VarChar(32)
  authorityWinnerId             String?  @map("authority_winner_id") @db.VarChar(128)
  shadowWinnerId                String?  @map("shadow_winner_id") @db.VarChar(128)
  eligibleForStrategyComparison Boolean  @map("eligible_for_strategy_comparison")
  divergenceTypes               String[] @map("divergence_types")
  divergenceSeverity            String   @map("divergence_severity") @db.VarChar(16)
  eventJson                     Json     @map("event_json")
  authorityResultJson           Json     @map("authority_result_json")
  shadowResultJson              Json?    @map("shadow_result_json")
  stageTracesJson               Json?    @map("stage_traces_json")
  reviewArtifactsJson           Json?    @map("review_artifacts_json")
  experimentId                  String?  @map("experiment_id") @db.VarChar(128)
  scenarioId                    String?  @map("scenario_id") @db.VarChar(128)
  benchmarkRunId                String?  @map("benchmark_run_id") @db.VarChar(128)
  createdAt                     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reviewCase DecisionShadowReviewCase?

  @@index([tripId, createdAt(sort: Desc)])
  @@index([decisionRunId])
  @@index([benchmarkRunId])
  @@map("decision_shadow_comparison")
}

/// Task E0 — Frozen blind A/B review case (one per comparisonId).
model DecisionShadowReviewCase {
  id                    String    @id @default(uuid()) @db.Uuid
  reviewCaseId          String    @unique @map("review_case_id") @db.VarChar(128)
  comparisonId          String    @unique @map("comparison_id") @db.VarChar(128)
  tripId                String    @map("trip_id") @db.VarChar(128)
  decisionRunId         String    @map("decision_run_id") @db.VarChar(256)
  status                String    @db.VarChar(16)
  blindedOptionAJson    Json      @map("blinded_option_a_json")
  blindedOptionBJson    Json      @map("blinded_option_b_json")
  frozenSnapshotsJson   Json      @map("frozen_snapshots_json")
  blindingVersion       String    @map("blinding_version") @db.VarChar(16)
  blindMappingEncrypted String    @map("blind_mapping_encrypted") @db.Text
  divergenceTypes       String[]  @map("divergence_types")
  divergenceSeverity    String    @map("divergence_severity") @db.VarChar(16)
  eligibilityVersion    String    @map("eligibility_version") @db.VarChar(16)
  exclusionReason       String?   @map("exclusion_reason") @db.VarChar(64)
  expectedReviewCount   Int       @default(1) @map("expected_review_count")
  completedReviewCount  Int       @default(0) @map("completed_review_count")
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt           DateTime? @map("completed_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  comparison  DecisionShadowComparison       @relation(fields: [comparisonId], references: [comparisonId])
  submissions DecisionShadowReviewSubmission[]

  @@index([status, createdAt(sort: Desc)])
  @@index([tripId])
  @@map("decision_shadow_review_case")
}

/// Task E0 — Blind manual review submission (server-derived classification).
model DecisionShadowReviewSubmission {
  id                String   @id @default(uuid()) @db.Uuid
  submissionId      String   @unique @map("submission_id") @db.VarChar(128)
  reviewCaseId      String   @map("review_case_id") @db.VarChar(128)
  reviewerId        String   @map("reviewer_id") @db.VarChar(128)
  reviewerGroup     String?  @map("reviewer_group") @db.VarChar(32)
  preferredOption   String   @map("preferred_option") @db.VarChar(32)
  classification    String   @map("classification") @db.VarChar(32)
  scoresJson        Json     @map("scores_json")
  tradeOffSummary   String?  @map("trade_off_summary") @db.Text
  confidence        Int?
  reviewDurationMs  Int?     @map("review_duration_ms")
  reviewFormVersion String   @default("v1") @map("review_form_version") @db.VarChar(16)
  idempotencyKey    String?  @unique @map("idempotency_key") @db.VarChar(256)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  reviewCase DecisionShadowReviewCase @relation(fields: [reviewCaseId], references: [reviewCaseId])

  @@unique([reviewCaseId, reviewerId])
  @@index([reviewCaseId])
  @@map("decision_shadow_review_submission")
}

/// Task E1 — Formal benchmark run registry (checkpoint/resume with frozen config).
model DecisionBenchmarkRun {
  id                      String    @id @default(uuid()) @db.Uuid
  benchmarkRunId          String    @unique @map("benchmark_run_id") @db.VarChar(128)
  benchmarkVersion        String    @map("benchmark_version") @db.VarChar(32)
  datasetVersion          String    @map("dataset_version") @db.VarChar(32)
  datasetChecksum         String    @map("dataset_checksum") @db.VarChar(64)
  split                   String    @db.VarChar(16)
  runtimeMode             String    @map("runtime_mode") @db.VarChar(32)
  authorityStrategyId     String    @map("authority_strategy_id") @db.VarChar(64)
  shadowStrategyId        String    @map("shadow_strategy_id") @db.VarChar(64)
  solverEngine            String    @map("solver_engine") @db.VarChar(64)
  objectiveRegistryVersion String   @map("objective_registry_version") @db.VarChar(32)
  constraintPolicyVersion String   @map("constraint_policy_version") @db.VarChar(32)
  configJson              Json      @map("config_json")
  configHash              String    @map("config_hash") @db.VarChar(64)
  status                  String    @default("CREATED") @db.VarChar(32)
  totalInstances          Int       @map("total_instances")
  completedInstances      Int       @default(0) @map("completed_instances")
  failedInstances         Int       @default(0) @map("failed_instances")
  excludedInstances       Int       @default(0) @map("excluded_instances")
  concurrency             Int       @default(1)
  maxAttempts             Int       @default(3) @map("max_attempts")
  shadowWaitTimeoutMs     Int       @default(120000) @map("shadow_wait_timeout_ms")
  gitCommit               String?   @map("git_commit") @db.VarChar(64)
  environmentHash         String?   @map("environment_hash") @db.VarChar(64)
  forkedFromRunId         String?   @map("forked_from_run_id") @db.VarChar(128)
  startedAt               DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt             DateTime? @map("completed_at") @db.Timestamptz(6)
  updatedAt               DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  instances DecisionBenchmarkInstanceExecution[]

  @@index([status, startedAt(sort: Desc)])
  @@map("decision_benchmark_run")
}

/// Task E1 — Per-instance staged execution checkpoint.
model DecisionBenchmarkInstanceExecution {
  id                            String    @id @default(uuid()) @db.Uuid
  benchmarkRunId                String    @map("benchmark_run_id") @db.VarChar(128)
  instanceId                    String    @map("instance_id") @db.VarChar(128)
  strategyVariant               String    @default("default") @map("strategy_variant") @db.VarChar(32)
  seed                          Int       @default(0)
  partition                     String?   @db.VarChar(32)
  status                        String    @default("PENDING") @db.VarChar(32)
  attemptCount                  Int       @default(0) @map("attempt_count")
  maxAttempts                   Int       @default(3) @map("max_attempts")
  requestId                     String    @unique @map("request_id") @db.VarChar(256)
  decisionRunId                 String?   @map("decision_run_id") @db.VarChar(256)
  comparisonId                  String?   @map("comparison_id") @db.VarChar(128)
  reviewCaseId                  String?   @map("review_case_id") @db.VarChar(128)
  inputHash                     String    @map("input_hash") @db.VarChar(64)
  requestHash                   String?   @map("request_hash") @db.VarChar(64)
  authorityResponseHash         String?   @map("authority_response_hash") @db.VarChar(64)
  shadowEventHash               String?   @map("shadow_event_hash") @db.VarChar(64)
  authorityWinnerId             String?   @map("authority_winner_id") @db.VarChar(128)
  shadowWinnerId                String?   @map("shadow_winner_id") @db.VarChar(128)
  eligibleForStrategyComparison Boolean?  @map("eligible_for_strategy_comparison")
  divergenceTypes               String[]  @map("divergence_types")
  exclusionReason               String?   @map("exclusion_reason") @db.VarChar(64)
  failureClass                  String?   @map("failure_class") @db.VarChar(32)
  lastErrorCode                 String?   @map("last_error_code") @db.VarChar(64)
  lastErrorMessage              String?   @map("last_error_message") @db.Text
  lastErrorStage                String?   @map("last_error_stage") @db.VarChar(32)
  lockedBy                      String?   @map("locked_by") @db.VarChar(128)
  leaseExpiresAt                DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  heartbeatAt                   DateTime? @map("heartbeat_at") @db.Timestamptz(6)
  artifactDirectory             String?   @map("artifact_directory") @db.VarChar(512)
  startedAt                     DateTime? @map("started_at") @db.Timestamptz(6)
  authorityCompletedAt          DateTime? @map("authority_completed_at") @db.Timestamptz(6)
  shadowCompletedAt             DateTime? @map("shadow_completed_at") @db.Timestamptz(6)
  completedAt                   DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt                     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  benchmarkRun DecisionBenchmarkRun @relation(fields: [benchmarkRunId], references: [benchmarkRunId])

  @@unique([benchmarkRunId, instanceId, strategyVariant, seed])
  @@index([benchmarkRunId, status])
  @@index([benchmarkRunId, createdAt])
  @@map("decision_benchmark_instance_execution")
}