model DecisionLog {
  id                   String            @id @default(uuid()) @db.Uuid
  tripId               String?           @map("trip_id") @db.Uuid
  countryCode          String?           @map("country_code") @db.VarChar(2)
  routeDirectionId     String?           @map("route_direction_id") @db.VarChar(255)
  persona              String            @db.VarChar(20)
  action               String            @db.VarChar(20)
  decisionSource       String            @map("decision_source") @db.VarChar(20)
  explanation          String
  reasonCodes          String[]          @map("reason_codes")
  evidenceRefs         String[]          @map("evidence_refs")
  timestamp            DateTime          @default(now())
  metadata             Json?
  decisionStage        String            @map("decision_stage") @db.VarChar(20)
  alignmentScore       Float?            @map("alignment_score")
  availableOptions     Json?             @map("available_options")
  confidenceLevel      Float?            @map("confidence_level")
  systemRecommendation Json?             @map("system_recommendation")
  userChoice           Json?             @map("user_choice")
  userReasoning        String?           @map("user_reasoning")
  outcomes             DecisionOutcome[]

  @@index([tripId])
  @@index([countryCode])
  @@index([routeDirectionId])
  @@index([decisionSource])
  @@index([decisionStage])
  @@index([persona])
  @@index([timestamp])
  @@index([countryCode, routeDirectionId, decisionSource])
  @@index([decisionStage, decisionSource])
  @@map("decision_logs")
}

model DecisionOutcome {
  id                  String      @id @default(uuid()) @db.Uuid
  decisionId          String      @map("decision_id") @db.Uuid
  expectedOutcome     Json        @map("expected_outcome")
  actualOutcome       Json        @map("actual_outcome")
  deviation           Json
  userSatisfaction    Float?      @map("user_satisfaction")
  userFeedback        String?     @map("user_feedback")
  learningSignals     Json        @map("learning_signals")
  /**
   * Join key to `DecisionCausalityRecordV0.causality_id` (Policy→Plan→Execution spine)
   */
  decisionCausalityId String?     @map("decision_causality_id") @db.VarChar(128)
  createdAt           DateTime    @default(now()) @map("created_at")
  DecisionLog         DecisionLog @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@index([decisionCausalityId])
  @@map("decision_outcomes")
}

