/// Commit saga ledger: action.execute vs side-effect apply (audit + recovery worker hooks)
model AgentActionLog {
  id               String    @id @default(uuid()) @db.Uuid
  requestId        String    @map("request_id") @db.VarChar(255)
  tripId           String    @map("trip_id") @db.VarChar(255)
  actionId         String    @map("action_id") @db.VarChar(255)
  actionName       String    @map("action_name") @db.VarChar(255)
  /// INIT | COMMITTED | SIDE_EFFECT_DONE | FAILED
  status           String    @db.VarChar(32)
  idempotencyKey   String?   @map("idempotency_key") @db.VarChar(255)
  payload          Json?
  lastError        String?   @map("last_error") @db.Text
  committedAt      DateTime? @map("committed_at") @db.Timestamptz(6)
  sideEffectDoneAt DateTime? @map("side_effect_done_at") @db.Timestamptz(6)
  failedAt         DateTime? @map("failed_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tripId, actionId, createdAt])
  @@index([status, updatedAt])
  @@map("agent_action_logs")
}

