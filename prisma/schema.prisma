/// Loop Engineering Phase 1 — persistent loop run (cross-request state machine).
model LoopRun {
  id               String          @id @db.Text
  tripId           String          @map("trip_id") @db.Text
  loopType         String          @map("loop_type") @db.Text
  status           String          @db.Text
  triggerEventId   String?         @map("trigger_event_id") @db.Text
  currentIteration Int             @default(0) @map("current_iteration")
  tokenBudget      Int?            @map("token_budget")
  costBudgetUsd    Float?          @map("cost_budget_usd")
  timeBudgetMs     Int?            @map("time_budget_ms")
  startedAt        DateTime        @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz(6)
  finalOutcome     Json?           @map("final_outcome")
  metadata         Json?
  Trip             Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  LoopIteration    LoopIteration[]

  @@index([tripId, startedAt(sort: Desc)])
  @@index([tripId, loopType, status])
  @@map("loop_runs")
}

/// Single observe → diagnose → propose → validate iteration within a loop run.
model LoopIteration {
  id               String   @id @db.Text
  loopRunId        String   @map("loop_run_id") @db.Text
  sequence         Int
  observedState    Json     @map("observed_state")
  diagnosis        Json
  proposedAction   Json     @map("proposed_action")
  validationResult Json     @map("validation_result")
  decision         String   @db.Text
  modelUsage       Json?    @map("model_usage")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  LoopRun          LoopRun  @relation(fields: [loopRunId], references: [id], onDelete: Cascade)

  @@unique([loopRunId, sequence])
  @@index([loopRunId, sequence])
  @@map("loop_iterations")
}

/// Travel outcome evaluation - answers "how good was the trip?"
model TravelOutcome {
  id                    String   @id @default(uuid()) @db.Uuid
  tripId                String   @map("trip_id") @db.Text
  success               String   @db.Text // excellent, good, acceptable, poor, failed
  satisfaction          Float // 0-10
  budgetPerformance     String   @map("budget_performance") @db.Text // under_budget, on_budget, slightly_over, significantly_over
  plannedBudget         Float    @map("planned_budget")
  actualSpent           Float    @map("actual_spent")
  budgetDeviation       Float    @map("budget_deviation")
  completionRate        String   @map("completion_rate") @db.Text // full, high, moderate, low
  plannedActivities     Int      @map("planned_activities")
  completedActivities   Int      @map("completed_activities")
  completionPercentage  Float    @map("completion_percentage")
  overallScore          Float    @map("overall_score") // 0-1
  metrics               Json? // Detailed outcome metrics
  factors               Json? // Factors that influenced outcome
  recommendations       Json? // Array of recommendation strings
  computedAt            DateTime @map("computed_at") @db.Timestamptz(6)
  dataQuality           Float    @map("data_quality") // 0-1
  confidence            Float // 0-1
  /// Round 3: Self-evolution architecture fields
  expectationGap        Float?   @map("expectation_gap") // 期望差距：实际 vs 预期
  stressEventCount      Int?     @map("stress_event_count") // 压力事件计数
  groupAggregationStrategy String? @map("group_aggregation_strategy") // 群组聚合策略
  shapleyAttribution    Json?    @map("shapley_attribution") // Shapley 归因结果
  memorySnapshot        Json?    @map("memory_snapshot") // 记忆快照
  /// 5维评分分量
  overallSatisfactionWeight  Float? @default(0.30) @map("overall_satisfaction_weight")
  budgetAccuracyWeight       Float? @default(0.20) @map("budget_accuracy_weight")
  completionQualityWeight    Float? @default(0.20) @map("completion_quality_weight")
  safetyWeight              Float? @default(0.15) @map("safety_weight")
  repurchaseWeight           Float? @default(0.15) @map("repurchase_weight")
  Trip                  Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([success])
  @@index([overallScore])
  @@map("travel_outcomes")
}

