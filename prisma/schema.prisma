  phase             String    @db.VarChar(40)
  depositCents      Int       @map("deposit_cents")
  totalPaidCents    Int?      @map("total_paid_cents")
  currency          String    @default("cny") @db.VarChar(3)
  paymentIntentId   String?   @map("payment_intent_id") @db.VarChar(255)
  matchRequestId    String?   @map("match_request_id") @db.Uuid
  refundCents       Int?      @map("refund_cents")
  stripeRefundId    String?   @map("stripe_refund_id") @db.VarChar(255)
  forfeitSplit      Json?     @map("forfeit_split")
  compensationSteps Json?     @map("compensation_steps")
  lockVersion       Int       @default(0) @map("lock_version")
  departureAt       DateTime? @map("departure_at") @db.Timestamptz(6)
