  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("user_reputation_profiles")
}

/// Match Learning P3 — 撮合 Soft Weights 当前生效配置（SSOT）
model MatchingSoftWeightConfig {
  id          String   @id @default("default") @db.VarChar(40)
  weights     Json
  version     Int      @default(1)
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  runs        MatchingSoftWeightRun[]

  @@map("matching_soft_weight_configs")
}

/// Match Learning P3 — 每周权重迭代审计
model MatchingSoftWeightRun {
  id              String   @id @default(uuid()) @db.Uuid
  configId        String   @default("default") @map("config_id") @db.VarChar(40)
  weekStart       DateTime @map("week_start") @db.Timestamptz(6)
  weekEnd         DateTime @map("week_end") @db.Timestamptz(6)
  positiveSamples Int      @default(0) @map("positive_samples")
  negativeSamples Int      @default(0) @map("negative_samples")
  weightBefore    Json     @map("weight_before")
  weightAfter     Json     @map("weight_after")
  adjustments     Json
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  config          MatchingSoftWeightConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([createdAt])
  @@map("matching_soft_weight_runs")
}
