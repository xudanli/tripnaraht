  validationStatus  String   @map("validation_status") @db.VarChar(20) // 'PENDING' | 'VALIDATED' | 'REJECTED'
  validationScore   Float    @map("validation_score")
  validationReasons String[] @default([]) @map("validation_reasons")

  // 轨迹内容（JSON）
