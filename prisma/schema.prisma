generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, vector]
}

model City {
  id          Int                       @id @default(autoincrement())
  name        String
  countryCode String
  adcode      String?
  nameCN      String?
  nameEN      String?
  location    Unsupported("geography")?
  timezone    String?
  metadata    Json?
  Place       Place[]
  District    District[]

  @@index([countryCode])
  @@index([nameCN])
  @@index([nameEN])
  @@index([name])
}

model CountryProfile {
  isoCode           String       @id @unique
  nameCN            String
  powerInfo         Json?
  emergency         Json?
  paymentInfo       Json?
  visaForCN         Json?
  /// 全球入境要求：{ officialLink?, byNationality: { US: {...}, CN: {...} } }
  entryRequirements Json?
  updatedAt         DateTime
  currencyCode      String?
  currencyName      String?
  exchangeRateToCNY Float?
  paymentType       PaymentType?
  exchangeRateToUSD Float?
  nameEN            String?
  /// 合规信息（签证政策、驾驶规则、无人机规则、酒精政策、旅行警告等）
  complianceInfo    Json?
  /// 旅行文化（小费习惯、禁忌列表、着装提示、节庆日历等）
  travelCulture     Json?
  /// 档案 schema 版本（仅 V2：算法决策就绪）
  schemaVersion     Int          @default(2)
  /// V2：极昼/极夜季节窗、环境触发器 Hook（与 complianceInfo 分工）
  timeBoundaries    Json?
  /// 目的地图（行程列表封面回退、GET /countries/:code/profile）
  coverImageUrl     String?
}

model DayOfWeekFactor {
  id            Int      @id @default(autoincrement())
  dayOfWeek     Int      @unique
  factor        Float
  sampleCount   Int      @default(0)
  avgPrice      Float?
  totalAvgPrice Float?
  lastUpdated   DateTime @default(now())
  updatedAt     DateTime
}

model FlightPriceDetail {
  id                          Int      @id @default(autoincrement())
  routeId                     String
  originCity                  String
  destinationCity             String
  month                       Int
  dayOfWeek                   Int?
  monthlyBasePrice            Float
  dayOfWeekFactor             Float?
  sampleCount                 Int      @default(0)
  minPrice                    Float?
  maxPrice                    Float?
  stdDev                      Float?
  source                      String?  @default("2023-2024年历史数据")
  lastUpdated                 DateTime @default(now())
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime
  destinationAirport          String?
  destinationAirportLatitude  Float?
  destinationAirportLongitude Float?
  originAirport               String?
  originAirportLatitude       Float?
  originAirportLongitude      Float?
  airlineCount                Int?     @default(0)
  arrivalTime                 String?
  departureTime               String?
  distanceKm                  Float?
  isWeekend                   Boolean? @default(false)
  monthFactor                 Float?
  timeOfDayFactor             Float?

  @@unique([routeId, month, dayOfWeek])
  @@index([originCity, destinationCity])
  @@index([routeId, month, dayOfWeek])
  @@index([routeId, month])
}

model FlightPriceReference {
  id              Int      @id @default(autoincrement())
  countryCode     String   @db.VarChar(2)
  originCity      String?  @db.VarChar(10)
  lowSeasonPrice  Int
  highSeasonPrice Int
  averagePrice    Int
  visaCost        Int      @default(0)
  source          String?  @db.VarChar(255)
  lastUpdated     DateTime @default(now()) @db.Timestamp(6)
  notes           String?
  createdAt       DateTime @default(now()) @db.Timestamp(6)
  updatedAt       DateTime @default(now()) @db.Timestamp(6)

  @@index([countryCode])
  @@index([countryCode, originCity])
}

model HotelPriceDetail {
  city        String   @id
  avgPrice    Float?
  medianPrice Float?
  cityFactor  Float?
  sampleCount Int      @default(0)
  minPrice    Float?
  maxPrice    Float?
  stdDev      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([city])
}

model HotelWideData_Quarterly {
  id         Int     @id @default(autoincrement())
  city       String?
  starRating Int?
  Q1_2018    Float?  @map("2018_Q1")
  Q2_2018    Float?  @map("2018_Q2")
  Q3_2018    Float?  @map("2018_Q3")
  Q4_2018    Float?  @map("2018_Q4")
  Q1_2019    Float?  @map("2019_Q1")
  Q2_2019    Float?  @map("2019_Q2")
  Q3_2019    Float?  @map("2019_Q3")
  Q4_2019    Float?  @map("2019_Q4")
  Q1_2020    Float?  @map("2020_Q1")
  Q2_2020    Float?  @map("2020_Q2")
  Q3_2020    Float?  @map("2020_Q3")
  Q4_2020    Float?  @map("2020_Q4")
  Q1_2021    Float?  @map("2021_Q1")
  Q2_2021    Float?  @map("2021_Q2")
  Q3_2021    Float?  @map("2021_Q3")
  Q4_2021    Float?  @map("2021_Q4")
  Q1_2022    Float?  @map("2022_Q1")
  Q2_2022    Float?  @map("2022_Q2")
  Q3_2022    Float?  @map("2022_Q3")
  Q4_2022    Float?  @map("2022_Q4")
  Q1_2023    Float?  @map("2023_Q1")
  Q2_2023    Float?  @map("2023_Q2")
  Q3_2023    Float?  @map("2023_Q3")
  Q4_2023    Float?  @map("2023_Q4")
  Q1_2024    Float?  @map("2024_Q1")

  @@index([city])
  @@index([city, starRating])
  @@index([starRating])
}

model ItineraryItem {
  id                         String       @id
  startTime                  DateTime?
  endTime                    DateTime?
  type                       ItemType
  placeId                    Int?
  tripDayId                  String
  note                       String?
  trailId                    Int?
  actualCost                 Float?
  costCategory               String?
  costNote                   String?
  currency                   String?      @default("CNY")
  estimatedCost              Float?
  isPaid                     Boolean      @default(false)
  paidBy                     String?
  bookedAt                   DateTime?
  bookingConfirmation        String?
  bookingStatus              String?
  bookingUrl                 String?
  travelFromPreviousDistance Int?
  travelFromPreviousDuration Int?
  travelMode                 String?
  order                      Int?
  Place                      Place?       @relation(fields: [placeId], references: [id])
  Trail                      Trail?       @relation(fields: [trailId], references: [id])
  TripDay                    TripDay      @relation(fields: [tripDayId], references: [id])
  RailSegment                RailSegment?

  @@index([costCategory])
  @@index([isPaid])
  @@index([bookingStatus])
  @@index([tripDayId, order])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Place {
  id                              Int                       @id @default(autoincrement())
  uuid                            String                    @unique
  nameEN                          String?
  category                        PlaceCategory
  location                        Unsupported("geography")?
  address                         String?
  cityId                          Int?
  metadata                        Json?
  /// Ontology rules for this POI/Place (Layer-1 Physical Domain constraints).
  /// Stored as JSONB so admin UI can manage rule sets atomically.
  ontologyRules                   Json?
  physicalMetadata                Json?
  googlePlaceId                   String?                   @unique
  rating                          Float?                    @default(0)
  createdAt                       DateTime                  @default(now())
  updatedAt                       DateTime
  nameCN                          String
  description                     String?
  embedding                       Unsupported("vector")?
  lastVerifiedAt                  DateTime?                 @map("last_verified_at") @db.Timestamptz(6)
  dataSource                      String?                   @map("data_source") @db.VarChar(50)
  dataFreshness                   String?                   @map("data_freshness") @db.VarChar(20)
  districtId                      Int?
  ItineraryItem                   ItineraryItem[]
  City                            City?                     @relation(fields: [cityId], references: [id])
  District                        District?                 @relation(fields: [districtId], references: [id], onDelete: SetNull)
  Trail_Trail_endPlaceIdToPlace   Trail[]                   @relation("Trail_endPlaceIdToPlace")
  Trail_Trail_startPlaceIdToPlace Trail[]                   @relation("Trail_startPlaceIdToPlace")
  TrailWaypoint                   TrailWaypoint[]
  PlaceEdgeFrom                   PlaceEdge[]               @relation("PlaceEdgeFrom")
  PlaceEdgeTo                     PlaceEdge[]               @relation("PlaceEdgeTo")
  CrowdCurve                      CrowdCurve[]
  PoiAccessRule                   PoiAccessRule[]
  PoiCapacitySnapshot             PoiCapacitySnapshot[]
  PoiCrowdingSnapshot             PoiCrowdingSnapshot[]
  PoiAccessStatusOverride         PoiAccessStatusOverride[]
  PoiExecutionFeedback            PoiExecutionFeedback[]
  TripAttractionExploreCandidate  TripAttractionExploreCandidate[]

  @@index([metadata(ops: JsonbPathOps)], type: Gin)
  @@index([lastVerifiedAt])
  @@index([dataFreshness])
  @@index([districtId])
}

/// Travel World Model Phase 2: Place 间显式边，支持 Micro Route 与路径优化
model PlaceEdge {
  id                   Int      @id @default(autoincrement())
  fromPlaceId          Int
  toPlaceId            Int
  distanceM            Int?
  walkTimeMin          Int?
  transitTimeMin       Int?
  experienceTransition String?  @db.VarChar(64)
  source               String?  @default("computed") @db.VarChar(32)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  fromPlace Place @relation("PlaceEdgeFrom", fields: [fromPlaceId], references: [id], onDelete: Cascade)
  toPlace   Place @relation("PlaceEdgeTo", fields: [toPlaceId], references: [id], onDelete: Cascade)

  @@unique([fromPlaceId, toPlaceId])
  @@index([fromPlaceId])
  @@index([toPlaceId])
}

/// Travel World Model Phase 3: 城市区域模型，支持区域游览约束与 District 级体验描述
model District {
  id                 Int                       @id @default(autoincrement())
  cityId             Int
  name               String
  nameCN             String?
  nameEN             String?
  center             Unsupported("geography")?
  radiusM            Int?
  dominantExperience String?                   @db.VarChar(64)
  vibe               Json? // ["historic","walkable","modern",...]
  metadata           Json?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  city  City    @relation(fields: [cityId], references: [id], onDelete: Cascade)
  Place Place[]

  @@index([cityId])
}

/// Travel World Model Phase 6: Place × Hour → crowdLevel，支持 Travel Simulation 与时段建议
model CrowdCurve {
  id         Int      @id @default(autoincrement())
  placeId    Int
  hour       Int // 0–23
  crowdLevel Float // 0–1，低到高
  source     String?  @default("estimated") @db.VarChar(32) // google_popular_times | estimated | manual
  dayOfWeek  Int? // 0–6，可选
  createdAt  DateTime @default(now())

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([placeId, hour, dayOfWeek])
  @@index([placeId])
}

/// POI Access & Capacity Engine — 准入规则（关闭/预约/车型/时段/步道等）
model PoiAccessRule {
  id                     String    @id @db.VarChar(191)
  poiId                  String    @map("poi_id") @db.VarChar(191)
  placeId                Int?      @map("place_id")
  ruleType               String    @map("rule_type") @db.VarChar(64)
  targetResource         String    @map("target_resource") @db.VarChar(32)
  validFrom              DateTime? @map("valid_from") @db.Date
  validTo                DateTime? @map("valid_to") @db.Date
  dailyStartTime         String?   @map("daily_start_time") @db.VarChar(5)
  dailyEndTime           String?   @map("daily_end_time") @db.VarChar(5)
  quota                  Int?
  reservationRequired    Boolean?  @map("reservation_required")
  applicableVehicleTypes Json?     @map("applicable_vehicle_types")
  status                 String    @db.VarChar(32)
  sourceAuthority        String    @map("source_authority") @db.VarChar(255)
  sourceUrl              String?   @map("source_url") @db.VarChar(1024)
  sourceUpdatedAt        DateTime? @map("source_updated_at") @db.Timestamptz(6)
  lastVerifiedAt         DateTime  @map("last_verified_at") @db.Timestamptz(6)
  confidence             String    @db.VarChar(16)
  /** HARD=阻断求解器；SOFT=FEASIBLE_WITH_RISK 建议 */
  enforcement            String    @default("HARD") @db.VarChar(16)
  notes                  String?   @db.Text
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([poiId, status])
  @@index([placeId])
  @@map("poi_access_rules")
}

/// POI Access & Capacity Engine — 日期/班次级库存快照
model PoiCapacitySnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  poiId           String   @map("poi_id") @db.VarChar(191)
  placeId         Int?     @map("place_id")
  dateISO         String   @map("date_iso") @db.VarChar(10)
  slotStartTime   String?  @map("slot_start_time") @db.VarChar(5)
  slotEndTime     String?  @map("slot_end_time") @db.VarChar(5)
  remaining       Int?
  capacity        Int?
  soldOut         Boolean  @default(false) @map("sold_out")
  signalSource    String   @map("signal_source") @db.VarChar(32)
  observedAt      DateTime @map("observed_at") @db.Timestamptz(6)
  confidenceScore Float?   @map("confidence_score")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([poiId, dateISO])
  @@index([placeId, dateISO])
  @@map("poi_capacity_snapshots")
}

/// POI Access & Capacity Engine — 拥堵融合快照
model PoiCrowdingSnapshot {
  id                    String   @id @default(uuid()) @db.Uuid
  poiId                 String   @map("poi_id") @db.VarChar(191)
  placeId               Int?     @map("place_id")
  observedAt            DateTime @map("observed_at") @db.Timestamptz(6)
  parkingOccupancyRatio Float?   @map("parking_occupancy_ratio")
  bookingRemaining      Int?     @map("booking_remaining")
  bookingCapacity       Int?     @map("booking_capacity")
  arrivalRatePerHour    Float?   @map("arrival_rate_per_hour")
  predictedWaitP50      Int?     @map("predicted_wait_p50")
  predictedWaitP90      Int?     @map("predicted_wait_p90")
  crowdLevel            String   @map("crowd_level") @db.VarChar(16)
  signalSources         Json     @map("signal_sources")
  confidenceScore       Float    @map("confidence_score")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([poiId, observedAt])
  @@index([placeId, observedAt])
  @@map("poi_crowding_snapshots")
}

/// POI Access & Capacity Engine — 官方公告驱动的动态状态覆盖（步道关闭、临时管制等）
model PoiAccessStatusOverride {
  id              String    @id @db.VarChar(191)
  poiId           String    @map("poi_id") @db.VarChar(191)
  placeId         Int?      @map("place_id")
  ruleType        String    @map("rule_type") @db.VarChar(64)
  targetResource  String    @map("target_resource") @db.VarChar(32)
  enforcement     String    @default("HARD") @db.VarChar(16)
  effectiveFrom   DateTime  @map("effective_from") @db.Timestamptz(6)
  effectiveTo     DateTime? @map("effective_to") @db.Timestamptz(6)
  status          String    @db.VarChar(32)
  sourceAuthority String    @map("source_authority") @db.VarChar(255)
  sourceUrl       String?   @map("source_url") @db.VarChar(1024)
  lastVerifiedAt  DateTime  @map("last_verified_at") @db.Timestamptz(6)
  confidence      String    @db.VarChar(16)
  notes           String?   @db.Text
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([poiId, status, effectiveFrom])
  @@index([placeId])
  @@map("poi_access_status_overrides")
}

/// POI 行中执行反馈 — 校准拥堵预测（匿名）
model PoiExecutionFeedback {
  id                  String   @id @default(uuid()) @db.Uuid
  poiId               String   @map("poi_id") @db.VarChar(191)
  placeId             Int?     @map("place_id")
  tripId              String?  @map("trip_id") @db.VarChar(191)
  dateISO             String   @map("date_iso") @db.VarChar(10)
  arrivalTime         String?  @map("arrival_time") @db.VarChar(5)
  parkingWaitMin      Int?     @map("parking_wait_min")
  visitDurationMin    Int?     @map("visit_duration_min")
  couldNotPark        Boolean  @default(false) @map("could_not_park")
  abandonedDueToCrowd Boolean  @default(false) @map("abandoned_due_to_crowd")
  crowdLevelSubjective String? @map("crowd_level_subjective") @db.VarChar(16)
  notes               String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  place Place? @relation(fields: [placeId], references: [id], onDelete: SetNull)

  @@index([poiId, dateISO])
  @@index([tripId])
  @@map("poi_execution_feedbacks")
}

model PoiAlias {
  id         Int      @id @default(autoincrement())
  poiId      String   @map("poi_id") @db.VarChar(191)
  alias      String   @db.VarChar(500)
  locale     String?  @db.VarChar(8)
  source     String   @default("SYSTEM") @db.VarChar(32)
  confidence Float    @default(1.0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([poiId, alias])
  @@index([alias])
  @@map("poi_aliases")
}

model PoiImportQueue {
  id             String   @id @default(uuid()) @db.Uuid
  queryName      String   @map("query_name") @db.VarChar(500)
  externalSource String   @map("external_source") @db.VarChar(32)
  externalId     String   @map("external_id") @db.VarChar(255)
  lat            Float
  lng            Float
  address        String?  @db.Text
  status         String   @default("PENDING") @db.VarChar(32)
  resolvedPoiId  String?  @map("resolved_poi_id") @db.VarChar(191)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@index([queryName])
  @@map("poi_import_queue")
}

model PoiResolutionLog {
  id         String   @id @default(uuid()) @db.Uuid
  queryName  String   @map("query_name") @db.VarChar(500)
  poiId      String?  @map("poi_id") @db.VarChar(191)
  method     String?  @db.VarChar(32)
  confidence Float    @default(0)
  evidence   Json     @default("[]")
  userId     String?  @map("user_id") @db.VarChar(191)
  confirmed  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([queryName])
  @@index([poiId])
  @@map("poi_resolution_logs")
}

model RailPassProfile {
  id                      String            @id
  tripId                  String            @unique
  residencyCountry        String
  passFamily              String
  passType                String
  validityType            String
  travelDaysTotal         Int?
  homeCountryOutboundUsed Int               @default(0)
  homeCountryInboundUsed  Int               @default(0)
  class                   String
  mobileOrPaper           String
  validityStartDate       DateTime
  validityEndDate         DateTime
  createdAt               DateTime          @default(now())
  updatedAt               DateTime
  Trip                    Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  RailSegment             RailSegment[]
  ReservationTask         ReservationTask[]

  @@index([tripId])
}

model RailSegment {
  id                  String            @id
  railPassProfileId   String
  itineraryItemId     String?           @unique
  fromPlaceId         Int
  toPlaceId           Int
  fromCountryCode     String
  toCountryCode       String
  departureDate       DateTime
  departureTimeWindow Json?
  arrivalDeadline     DateTime?
  operatorHint        String?
  isNightTrain        Boolean           @default(false)
  isHighSpeed         Boolean           @default(false)
  isInternational     Boolean           @default(false)
  crossesMidnight     Boolean           @default(false)
  t_api               Int?
  t_robust            Int?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime
  ItineraryItem       ItineraryItem?    @relation(fields: [itineraryItemId], references: [id])
  RailPassProfile     RailPassProfile   @relation(fields: [railPassProfileId], references: [id], onDelete: Cascade)
  ReservationTask     ReservationTask[]

  @@index([departureDate])
  @@index([itineraryItemId])
  @@index([railPassProfileId])
}

model RawAttractionData {
  id             Int      @id @default(autoincrement())
  name           String
  level          String?
  address        String?
  province       String?
  publishDate    String?
  documentUrl    String?
  encodedAddress String?
  lng            Float?
  lat            Float?
  importedAt     DateTime @default(now())
  processed      Boolean  @default(false)

  @@index([level])
  @@index([processed])
  @@index([province])
  @@index([province, level])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model RawFlightData {
  departureY Decimal? @map("起飞机场y") @db.Decimal
  departureX Decimal? @map("起飞机场x") @db.Decimal
  arrivalY   Decimal? @map("降落机场y") @db.Decimal
  arrivalX   Decimal? @map("降落机场x") @db.Decimal

  @@ignore
}

model RawHotelData_Slim {
  id       String  @id
  name     String?
  brand    String?
  address  String?
  city     String?
  district String?
  lat      Float?
  lng      Float?
  phone    String?
  type     String?
  adcode   String?

  @@index([brand])
  @@index([city, brand])
  @@index([city, district])
  @@index([city])
}

model RawTrainStationData {
  id            Int      @id @default(autoincrement())
  name          String
  address       String?
  railwayBureau String?
  category      String?
  nature        String?
  province      String?
  city          String?
  wgs84Lng      Float?
  wgs84Lat      Float?
  importedAt    DateTime @default(now())
  processed     Boolean  @default(false)

  @@index([city])
  @@index([nature])
  @@index([processed])
  @@index([province, city])
  @@index([province])
  @@index([railwayBureau])
}

model ReadinessPack {
  id                    String                  @id
  packId                String                  @unique
  destinationId         String
  displayName           String
  version               String
  lastReviewedAt        DateTime
  countryCode           String
  region                String?
  city                  String?
  latitude              Float?
  longitude             Float?
  packData              Json
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  cityCN                String?                 @map("city_cn")
  cityEN                String?                 @map("city_en")
  displayNameCN         String?                 @map("display_name_cn")
  displayNameEN         String?                 @map("display_name_en")
  regionCN              String?                 @map("region_cn")
  regionEN              String?                 @map("region_en")
  TripReadinessDecision TripReadinessDecision[]

  @@index([countryCode])
  @@index([countryCode, isActive])
  @@index([destinationId])
  @@index([isActive])
  @@index([packId])
  @@index([displayNameCN])
  @@index([displayNameEN])
}

model TripReadinessDecision {
  id              String         @id @default(uuid()) @db.Uuid
  tripId          String         @map("trip_id")
  ruleId          String         @map("rule_id")
