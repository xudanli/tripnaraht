  activatedAt     DateTime? @map("activated_at") @db.Timestamptz(6)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  definitions     ExecutionRiskDefinition[]
  severityRules   ExecutionRiskSeverityRule[]
  causalChains    ExecutionRiskCausalChain[]
  actions         ExecutionRiskInterventionAction[]
  codeMappings    ExecutionRiskCodeMapping[]

  @@map("execution_risk_knowledge_versions")
