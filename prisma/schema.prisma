// ============================================================================
// Phase 2 Data Flywheel - 数据飞轮四层结构
// 参考: docs/PHASE2_DATA_FLYWHEEL_DESIGN.md
// ============================================================================

/// Layer 1: 决策记录 - 记录系统当时如何思考，为学习提供输入
model FlywheelDecisionLog {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  tripId          String   @map("trip_id") @db.Uuid
  decisionLogId   String?  @map("decision_log_id") @db.Uuid
  contextSnapshot Json     @map("context_snapshot")
  utilityWeights  Json     @map("utility_weights")
  candidatePlans  Json?    @map("candidate_plans")
  selectedPlan    Json?    @map("selected_plan")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([tripId])
  @@index([createdAt(sort: Desc)])
  @@map("flywheel_decision_logs")
}

/// Layer 2: 用户行为 - 用户如何修改，行为=偏好信号
model FlywheelBehaviorLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  tripId         String   @map("trip_id") @db.Uuid
  planId         String?  @map("plan_id")
  eventType      String   @map("event_type") @db.VarChar(50)
  beforeState    Json?    @map("before_state")
  afterState     Json?    @map("after_state")
  deltaDistance  Float?   @map("delta_distance")
  deltaElevation Float?   @map("delta_elevation")
  deltaTime      Int?     @map("delta_time")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([tripId])
  @@index([eventType])
  @@index([createdAt(sort: Desc)])
  @@map("flywheel_behavior_logs")
}

/// Layer 3: 结果捕捉 - 旅行结束后的真实数据
model FlywheelOutcome {
  id                 String   @id @default(uuid()) @db.Uuid
  tripId             String   @map("trip_id") @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  subjectiveFeedback Json?    @map("subjective_feedback")
  objectiveExecution Json?    @map("objective_execution")
  failureSignals     Json?    @map("failure_signals")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([tripId])
  @@index([userId])
  @@index([createdAt(sort: Desc)])
  @@map("flywheel_outcomes")
}

/// Layer 4: 参数版本 - 学习结果版本化，支持回滚
model FlywheelParameterSet {
  id                  String   @id @default(uuid()) @db.Uuid
  version             String   @db.VarChar(50)
  scope               String   @db.VarChar(20)
