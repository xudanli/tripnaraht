// ========== 地理数据质量监控模型 🔴 P0 新增 ==========

model GeographicDataQualityMonitor {
  id          String @id @default(uuid()) @db.Uuid
  dataSource  String @map("data_source") @db.VarChar(100) // 'switzerland-dem' | 'norway-rivers' | ...
  dataType    String @map("data_type") @db.VarChar(50) // 'DEM' | 'RIVERS' | 'MOUNTAINS' | 'ROADS' | 'COASTLINES' | 'PORTS' | 'RAILWAYS'
