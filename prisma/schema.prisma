  lastUpdated  DateTime @map("last_updated")
  lastVerified DateTime @map("last_verified")
  recordCount  Int      @default(0) @map("record_count")

  // 状态
  status String @default("HEALTHY") @db.VarChar(20) // 'HEALTHY', 'WARNING', 'CRITICAL'

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  alerts DataQualityAlert[]

  @@unique([dataSource, dataType])
  @@index([countryCode])
  @@index([status])
  @@index([overallScore])
  @@map("data_quality_monitors")
}

model DataQualityAlert {
  id                  String  @id @default(uuid()) @db.Uuid
  monitorId           String? @map("monitor_id") @db.Uuid
  geographicMonitorId String? @map("geographic_monitor_id") @db.Uuid
  severity            String  @db.VarChar(20) // 'CRITICAL', 'HIGH', 'MEDIUM', 'LOW'
  alertType           String  @map("alert_type") @db.VarChar(50) // 'QUALITY_LOW', 'DATA_EXPIRED', 'UPDATE_FAILED'
  message             String  @db.Text
  details             Json? // 详细问题信息

  // 处理状态
