// 已验证轨迹表（用于模型训练）
model ValidatedTrajectory {
  id           String  @id @default(uuid()) @db.Uuid
  trajectoryId String  @unique @map("trajectory_id") @db.VarChar(255)
  requestId    String  @map("request_id") @db.VarChar(255)
