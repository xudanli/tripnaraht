}

model TripAttempt {
  id                 String    @id @default(uuid()) @db.Uuid
  tripRunId          String    @map("trip_run_id") @db.Uuid
  attemptNumber      Int       @default(1) @map("attempt_number")
  planOutline        String?   @map("plan_outline")
  openQuestions      String[]  @map("open_questions")
  constraintsAssumed String[]  @map("constraints_assumed")
  nextActions        String[]  @map("next_actions")
  failureNotes       String?   @map("failure_notes")
  status             String    @default("PENDING") @db.VarChar(20)
  resultSummary      String?   @map("result_summary")
  artifacts          Json?
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  completedAt        DateTime? @map("completed_at")
  metadata           Json?
