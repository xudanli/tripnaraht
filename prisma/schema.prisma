  @@unique([tripId, domain, userId], map: "trip_domain_weight_overrides_unique")
  @@index([tripId, domain])
  @@map("trip_domain_weight_overrides")
}

/// Structured preference sharing round (F3.1 — Round Robin / Voice Effect)
model TripPreferenceRound {
  id            String   @id @default(uuid()) @db.Uuid
  tripId        String   @map("trip_id")
  domain        String   @db.VarChar(32)
  decisionNode  String   @map("decision_node") @db.VarChar(32)
  status        String   @default("collecting") @db.VarChar(16)
  turnOrder     Json     @map("turn_order")
  currentTurn   Int      @default(0) @map("current_turn")
  closesAt      DateTime? @map("closes_at") @db.Timestamptz(6)
  closedAt      DateTime? @map("closed_at") @db.Timestamptz(6)
  createdBy     String   @map("created_by") @db.Text
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  Trip          Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
