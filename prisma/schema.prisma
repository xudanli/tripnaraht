  roundId      String   @map("round_id") @db.Uuid
  voterId      String   @map("voter_id") @db.Text
  targetUserId String   @map("target_user_id") @db.Text
  heard        Boolean
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  round        TripPreferenceRound @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@unique([roundId, voterId, targetUserId])
  @@index([roundId, targetUserId])
  @@map("trip_preference_heard_votes")
}

/// Member participation snapshot for Voice Guard (F3.3 foundation)
