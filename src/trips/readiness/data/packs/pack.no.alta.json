  "hazards": [
    {
      "type": "weather_stable_cold",
      "severity": "high",
      "summary": {
        "en": "Alta has a more stable, dry climate than Tromsø, which is good for Aurora but means colder temperatures (often -15°C to -25°C).",
        "zh": "阿尔塔的气候比特罗姆瑟更稳定、干燥，这有利于极光观测，但也意味着更低的气温（通常在 -15°C 到 -25°C）。"
      },
      "mitigations": [
        {
          "en": "Pack heavy wool layers.",
          "zh": "打包厚羊毛层。"
        }
      ]
    }
  ],
  "checklists": [
    {
      "id": "chk.no.alta.sorrisniva",
      "category": "booking",
      "appliesToSeasons": ["winter"],
      "items": [
        {
          "en": "Book Sorrisniva Igloo Hotel overnight stay well in advance.",
          "zh": "提前预订 Sorrisniva 冰酒店的过夜住宿。"
        },
        {
          "en": "Pack wool long johns and a hat for sleeping (sleeping bags are provided, but head stays out).",
          "zh": "打包羊毛长裤和睡帽（酒店提供睡袋，但头露在外面）。"
        }
      ]
    },
    {
      "id": "chk.no.alta.museum",
      "category": "culture",
      "appliesToSeasons": ["winter"],
      "items": [
        {
          "en": "Note: Outdoor UNESCO Rock Carvings are covered in snow in winter. Only the museum indoor exhibition is open.",
          "zh": "注意：户外的 UNESCO 岩画在冬季被雪覆盖。只有博物馆室内展览开放。"
        }
      ]
    }
  ],
  "rules": [
