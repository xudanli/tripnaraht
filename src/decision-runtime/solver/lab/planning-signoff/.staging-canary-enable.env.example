# Staging selected_trips canary — source on the staging API/runtime host only.
# Kill-switch: unset OR_TOOLS_AUTHORITATIVE_CANARY ; export OR_TOOLS_CANARY_STAGE=shadow
#
# Also source: .staging-authority-token.env (token + secret)

OR_TOOLS_AUTHORITY_ENVIRONMENT=staging
OR_TOOLS_CANARY_STAGE=selected_trips
OR_TOOLS_AUTHORITATIVE_CANARY=1
