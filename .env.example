# TripNARA 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ==================== 数据库配置 ====================
DATABASE_URL=postgresql://user:password@localhost:5432/tripnara

# ==================== Redis 配置 ====================
REDIS_URL=redis://localhost:6379

# ==================== LLM 提供商配置 ====================

# OpenAI (主要 LLM 提供商)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# DeepSeek (备用 LLM 提供商，成本低)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# Anthropic Claude (高质量推理)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Gemini (多模态)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-pro

# ==================== Python AI 服务配置 ====================
# 独立部署的 Python AI 服务，提供 BGE-M3 Embedding 和 Reranker
# 
# 生产环境服务地址: http://121.43.192.56:8001
# API 文档: http://121.43.192.56:8001/docs
# 健康检查: http://121.43.192.56:8001/health

# 服务地址
# 开发环境: http://localhost:8001
# 生产环境: http://121.43.192.56:8001
PYTHON_AI_SERVICE_URL=http://120.26.179.64:8001

# 是否启用 Python AI 服务 (true/false)
# 禁用时将降级到 OpenAI Embedding
PYTHON_AI_SERVICE_ENABLED=true

# 请求超时时间 (毫秒)
PYTHON_AI_SERVICE_TIMEOUT=30000

# 健康检查超时时间 (毫秒)
# 健康检查可能需要更长时间，特别是跨网络连接
# 默认 15 秒，如果网络延迟较高可以增加到 30 秒
PYTHON_AI_SERVICE_HEALTH_TIMEOUT=15000

# 是否禁用代理 (true/false)
# Python AI 服务通常在内网部署，不需要代理
# 如果遇到连接问题，确保此选项为 true
PYTHON_AI_DISABLE_PROXY=true

# ==================== Embedding 配置 ====================

# Embedding 提供商: python | openai
# python: 使用 Python AI 服务的 BGE-M3 (推荐，本地部署)
# openai: 使用 OpenAI text-embedding-3-small (云端)
EMBEDDING_PROVIDER=python

# Embedding 维度 (需与提供商匹配)
# BGE-M3: 1024
# OpenAI text-embedding-3-small: 1536
EMBEDDING_DIMENSION=1024

# ==================== 向量搜索配置 ====================

# 向量搜索提供商: pgvector | qdrant | milvus
VECTOR_STORE_PROVIDER=pgvector

# Qdrant 配置 (如果使用 Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Milvus 配置 (如果使用 Milvus)
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ==================== 外部 API 配置 ====================

# Mapbox (地图服务)
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token

# Google Maps (POI、路线规划)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# 高德地图 (中国大陆 POI、路线)
AMAP_API_KEY=your-amap-key

# Smithery (MCP 服务连接)
# 用于连接 Smithery 托管的 MCP 服务（如 Airbnb、Google Calendar 等）
# 获取 API Key: https://smithery.ai/account/api-keys
SMITHERY_API_KEY=your-smithery-api-key

# Amadeus API (航班搜索)
# 获取方式: https://developers.amadeus.com/
# 支持两种命名方式（任选一种）:
AMADEUS_CLIENT_ID=your-amadeus-client-id
AMADEUS_CLIENT_SECRET=your-amadeus-client-secret
AMADEUS_HOSTNAME=test
# 或者:
# AMADEUS_API_KEY=your-amadeus-api-key
# AMADEUS_API_SECRET=your-amadeus-api-secret
# AMADEUS_BASE_URL=test.api.amadeus.com

# Exa API (Web 搜索、代码搜索、公司研究)
# 获取 API Key: https://dashboard.exa.ai/api-keys
EXA_API_KEY=your-exa-api-key

# ==================== 服务配置 ====================

# 服务端口
PORT=3000

# Decision Kernel 是否启用 (true/false)
# Phase 2.4 灰度/回滚：设置为 false 可回滚到无 DSO 路径
DECISION_KERNEL_ENABLED=true

# P1 A/B 实验：分流比例 0-100，0=全量 Kernel，10=10% 实验组（Kernel）
# 未设置或 0 时等效于全量；100 时全量
# DECISION_KERNEL_AB_PERCENT=10

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 环境: development | staging | production
NODE_ENV=development

# ==================== 安全配置 ====================

# JWT 密钥
JWT_SECRET=your-jwt-secret-key

# JWT Token 过期时间配置
# Access Token 过期时间 (格式: 数字+单位，如 15m, 1h, 48h, 7d)
JWT_ACCESS_TOKEN_EXPIRES_IN=48h
# Refresh Token 过期天数
JWT_REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# ==================== 开发配置 ====================

# 禁用代理 (开发环境建议设为 true)
LLM_DISABLE_PROXY=true
OPENAI_DISABLE_PROXY=true

# Mock 模式 (LLM API 不可用时自动启用)
LLM_USE_MOCK=false

# ==================== KPU 知识处理单元配置 ====================
# KPU (Knowledge Processing Unit) 用于知识核验与规则校验

# 是否启用片段验证 (true/false)
# 启用后会在检索阶段实时验证知识片段
KPU_ENABLE_SNIPPET_VALIDATION=true

# 最低验证得分阈值 (0-1)
# 低于此得分的知识片段会被过滤
KPU_MIN_VALIDATION_SCORE=0.6

# 缓存过期时间 (秒)
# 验证结果缓存时间，默认1小时
KPU_CACHE_TTL=3600

# 默认LLM Provider (DEEPSEEK | OPENAI | ANTHROPIC | GEMINI)
# 用于事实检查、一致性检查和生成回答
KPU_DEFAULT_LLM_PROVIDER=DEEPSEEK

# 验证选项
# 启用事实检查
KPU_ENABLE_FACT_CHECK=true
# 启用一致性检查
KPU_ENABLE_CONSISTENCY_CHECK=true
# 启用引用检查
KPU_ENABLE_CITATION_CHECK=true

# 性能配置
# 最大并发验证数
KPU_MAX_CONCURRENT_VALIDATIONS=10
# 最大并发生成数
KPU_MAX_CONCURRENT_GENERATIONS=5
# 验证超时时间 (毫秒)
KPU_VALIDATION_TIMEOUT=5000
# 生成超时时间 (毫秒)
KPU_GENERATION_TIMEOUT=10000

# 缓存配置
# 启用内存缓存
KPU_CACHE_ENABLED=true
# 内存缓存最大条目数
KPU_CACHE_MEMORY_SIZE=1000
# 启用Redis缓存 (需要Redis服务)
KPU_CACHE_REDIS_ENABLED=true

# ==================== 邮件服务配置 ====================
# 企业微信邮箱 SMTP 配置
# 授权码获取方式: 登录企业微信邮箱 -> 设置 -> 客户端专用密码 -> 生成新密码
#
# 需要配置两个企业微信邮箱:
# 1. noreply@tripnara.com - 发送验证码等系统邮件
# 2. support@tripnara.com - 接收用户反馈（客服通知邮箱）

# SMTP 服务器地址 (企业微信邮箱)
SMTP_HOST=smtp.exmail.qq.com
# SMTP 端口: 465 (SSL) 或 587 (STARTTLS)
SMTP_PORT=465
# 是否启用 SSL (465端口需设为 true)
SMTP_SECURE=true
# 企业微信邮箱账号 (用于发送系统邮件)
SMTP_USER=noreply@tripnara.com
# 企业微信邮箱授权码（客户端专用密码）
SMTP_PASSWORD=your-authorization-code
# 发件人地址
SMTP_FROM=noreply@tripnara.com

# 客服通知邮箱 (接收用户反馈)
CONTACT_NOTIFICATION_EMAIL=support@tripnara.com

# ==================== Context Orchestrator (分段规划 POC) ====================
# 启用 Day1→Day2→Day3 迭代生成（当行程 >= 3 天时）
# 设为 false 可禁用，默认启用
INCREMENTAL_ITINERARY_POC=true

# ==================== ExpectedUtility 参数日志 (Phase 3) ====================
# 评估日志采样率：1=100%, 0.1=10%。生产环境可适当降低以控制存储
EXPECTED_UTILITY_LOG_SAMPLE_RATE=1
