# TripNARA 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ==================== 数据库配置 ====================
DATABASE_URL=postgresql://user:password@localhost:5432/tripnara

# ==================== Redis 配置 ====================
REDIS_URL=redis://localhost:6379

# ==================== LLM 提供商配置 ====================

# OpenAI (主要 LLM 提供商)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# DeepSeek (备用 LLM 提供商，成本低)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat

# Anthropic Claude (高质量推理)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Gemini (多模态)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-pro

# ==================== Python AI 服务配置 ====================
# 独立部署的 Python AI 服务，提供 BGE-M3 Embedding 和 Reranker
# 
# 生产环境服务地址: http://101.37.210.241:8001
# API 文档: http://101.37.210.241:8001/docs
# 健康检查: http://101.37.210.241:8001/health

# 服务地址
# 开发环境: http://localhost:8001
# 生产环境: http://101.37.210.241:8001
PYTHON_AI_SERVICE_URL=http://101.37.210.241:8001

# 是否启用 Python AI 服务 (true/false)
# 禁用时将降级到 OpenAI Embedding
PYTHON_AI_SERVICE_ENABLED=true

# 请求超时时间 (毫秒)
PYTHON_AI_SERVICE_TIMEOUT=30000

# 健康检查超时时间 (毫秒)
# 健康检查可能需要更长时间，特别是跨网络连接
# 默认 15 秒，如果网络延迟较高可以增加到 30 秒
PYTHON_AI_SERVICE_HEALTH_TIMEOUT=15000

# 是否禁用代理 (true/false)
# Python AI 服务通常在内网部署，不需要代理
# 如果遇到连接问题，确保此选项为 true
PYTHON_AI_DISABLE_PROXY=true

# ==================== Embedding 配置 ====================

# Embedding 提供商: python | openai
# python: 使用 Python AI 服务的 BGE-M3 (推荐，本地部署)
# openai: 使用 OpenAI text-embedding-3-small (云端)
EMBEDDING_PROVIDER=python

# Embedding 维度 (需与提供商匹配)
# BGE-M3: 1024
# OpenAI text-embedding-3-small: 1536
EMBEDDING_DIMENSION=1024

# ==================== 向量搜索配置 ====================

# 向量搜索提供商: pgvector | qdrant | milvus
VECTOR_STORE_PROVIDER=pgvector

# Qdrant 配置 (如果使用 Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Milvus 配置 (如果使用 Milvus)
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ==================== 外部 API 配置 ====================

# Mapbox (地图服务)
MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token

# Google Maps (POI、路线规划)
GOOGLE_MAPS_API_KEY=your-google-maps-key

# 高德地图 (中国大陆 POI、路线)
AMAP_API_KEY=your-amap-key

# ==================== 服务配置 ====================

# 服务端口
PORT=3000

# 日志级别: debug | info | warn | error
LOG_LEVEL=info

# 环境: development | staging | production
NODE_ENV=development

# ==================== 安全配置 ====================

# JWT 密钥
JWT_SECRET=your-jwt-secret-key

# ==================== 开发配置 ====================

# 禁用代理 (开发环境建议设为 true)
LLM_DISABLE_PROXY=true
OPENAI_DISABLE_PROXY=true

# Mock 模式 (LLM API 不可用时自动启用)
LLM_USE_MOCK=false
