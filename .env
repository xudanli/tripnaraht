# ==================== KPU 知识处理单元配置 ====================
# KPU (Knowledge Processing Unit) 用于知识核验与规则校验

# 是否启用片段验证 (true/false)
# 启用后会在检索阶段实时验证知识片段
KPU_ENABLE_SNIPPET_VALIDATION=true

# 最低验证得分阈值 (0-1)
# 低于此得分的知识片段会被过滤
KPU_MIN_VALIDATION_SCORE=0.6

# 缓存过期时间 (秒)
# 验证结果缓存时间，默认1小时
KPU_CACHE_TTL=3600

# 默认LLM Provider (DEEPSEEK | OPENAI | ANTHROPIC | GEMINI)
# 用于事实检查、一致性检查和生成回答
KPU_DEFAULT_LLM_PROVIDER=DEEPSEEK

# 验证选项
# 启用事实检查
KPU_ENABLE_FACT_CHECK=true
# 启用一致性检查
KPU_ENABLE_CONSISTENCY_CHECK=true
# 启用引用检查
KPU_ENABLE_CITATION_CHECK=true

# 性能配置
# 最大并发验证数
KPU_MAX_CONCURRENT_VALIDATIONS=10
# 最大并发生成数
KPU_MAX_CONCURRENT_GENERATIONS=5
# 验证超时时间 (毫秒)
KPU_VALIDATION_TIMEOUT=5000
# 生成超时时间 (毫秒)
KPU_GENERATION_TIMEOUT=10000

# 缓存配置
# 启用内存缓存
KPU_CACHE_ENABLED=true
# 内存缓存最大条目数
KPU_CACHE_MEMORY_SIZE=1000
# 启用Redis缓存 (需要Redis服务)
KPU_CACHE_REDIS_ENABLED=true


# 禁用 LLM 代理（DeepSeek API 直接连接）
LLM_DISABLE_PROXY=true

ENABLE_ROUTE_DIRECTIONS_MODULE=true

