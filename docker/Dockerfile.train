# TripNARA LoRA 微调训练环境
# 基于 NVIDIA CUDA 镜像，支持 GPU 训练

FROM nvidia/cuda:12.1.0-cudnn8-devel-ubuntu22.04

# 设置环境变量
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_NO_CACHE_DIR=1
ENV CUDA_HOME=/usr/local/cuda
ENV PATH="${CUDA_HOME}/bin:${PATH}"
ENV LD_LIBRARY_PATH="${CUDA_HOME}/lib64:${LD_LIBRARY_PATH}"

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 \
    python3.11-dev \
    python3.11-venv \
    python3-pip \
    git \
    wget \
    curl \
    vim \
    htop \
    nvtop \
    && rm -rf /var/lib/apt/lists/*

# 设置 Python 3.11 为默认
RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.11 1

# 创建工作目录
WORKDIR /app

# 升级 pip
RUN pip install --upgrade pip setuptools wheel

# 安装 PyTorch (CUDA 12.1)
RUN pip install torch==2.2.0 torchvision==0.17.0 torchaudio==2.2.0 \
    --index-url https://download.pytorch.org/whl/cu121

# 安装训练框架和依赖
RUN pip install \
    transformers==4.40.0 \
    datasets==2.18.0 \
    accelerate==0.29.0 \
    peft==0.10.0 \
    bitsandbytes==0.43.0 \
    scipy==1.13.0 \
    sentencepiece==0.2.0 \
    protobuf==4.25.3 \
    tiktoken==0.6.0 \
    einops==0.7.0 \
    flash-attn==2.5.6 --no-build-isolation \
    deepspeed==0.14.0 \
    wandb==0.16.6 \
    mlflow==2.12.1 \
    ray==2.10.0

# 安装 LLaMA-Factory
RUN pip install llamafactory==0.6.3

# 安装其他工具
RUN pip install \
    fastapi==0.110.0 \
    uvicorn==0.29.0 \
    redis==5.0.3 \
    httpx==0.27.0 \
    pydantic==2.6.4 \
    python-multipart==0.0.9

# 复制训练脚本
COPY python/train /app/train
COPY python/serve /app/serve

# 创建模型和数据目录
RUN mkdir -p /app/models /app/data /app/outputs /app/logs

# 设置权限
RUN chmod -R 755 /app

# 暴露端口
EXPOSE 8000 8001 6006

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 默认命令：启动训练服务
CMD ["python", "-m", "uvicorn", "train.api:app", "--host", "0.0.0.0", "--port", "8000"]
