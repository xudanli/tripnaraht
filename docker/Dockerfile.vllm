# TripNARA vLLM 推理服务环境
# 基于 vLLM 官方镜像，支持 LoRA 热加载

FROM vllm/vllm-openai:v0.4.0.post1

# 设置环境变量
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV HF_HOME=/app/models/huggingface
ENV VLLM_ATTENTION_BACKEND=FLASH_ATTN

# 创建工作目录
WORKDIR /app

# 安装额外依赖
RUN pip install \
    redis==5.0.3 \
    httpx==0.27.0 \
    mlflow==2.12.1

# 复制服务脚本
COPY python/serve /app/serve

# 创建目录
RUN mkdir -p /app/models/base /app/models/lora /app/logs

# 暴露端口
# 8000: OpenAI 兼容 API
# 8001: 管理 API（LoRA 热加载等）
EXPOSE 8000 8001

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 默认启动命令
# 使用 entrypoint.sh 支持动态配置
COPY docker/vllm-entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENTRYPOINT ["/app/entrypoint.sh"]
