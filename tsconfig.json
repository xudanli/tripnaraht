{
  "compilerOptions": {
    "lib": ["esnext", "dom"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    // 👇👇👇 NestJS 装饰器支持（必须开启）👇👇👇
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // 👆👆👆 装饰器配置结束 👆👆👆
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "scripts",
    "**/*.spec.ts",
    "**/*.e2e-spec.ts",
    "**/*.test.ts",
    "**/*.hooks.example.ts",
    "src/mcp/mcp-skills-server.ts",
    "src/mcp/mcp-schema-builders.ts",
    "src/mcp/run-server-direct.ts",
    "src/mcp/diagnose-server.ts",
    "src/mcp/diagnose-timeout.ts",
    "src/mcp/test-mcp-skills.ts",
    "src/mcp/airbnb-bridge-server.ts",
    "src/mcp/google-calendar-bridge-server.ts",
    "src/mcp/google-maps-bridge-server.ts",
    "src/mcp/mcp-schema-builders.ts",
    "src/mcp/debug-startup.ts",
    "src/mcp/verify-skills-registration.ts",
    "src/match-square/**",
    "src/match-learning/**",
    "src/reputation-os/**",
    "src/odyssey-intake/engine/companion-matching.engine.ts"
  ]
}
