# Exploration AI 路线生成 — 环境变量示例（复制到 .env）
# 实网验证：npx tsx scripts/exploration-ai-live-verify.ts

# ========== 基础 Gate ==========
DECISION_GATEWAY_UNIFIED=1
EXPLORATION_CONSUMER_MVP_ENABLED=1

# ========== AI 路线生成 ==========
# 1 启用 AI 生成（默认 PERSONALIZED）
EXPLORATION_AI_ROUTE_GENERATION=1

# STATIC | PERSONALIZED | ENGINE
EXPLORATION_ROUTE_GENERATION_MODE=ENGINE

# LLM 叙事（模板 stub + 可选 live）
EXPLORATION_LLM_ROUTE_NARRATIVE=1
EXPLORATION_LLM_ROUTE_NARRATIVE_LIVE=1

# 原则页智能总结（RULES 默认；live 需 DeepSeek）
EXPLORATION_PRINCIPLE_SUMMARY=1
EXPLORATION_LLM_PRINCIPLE_SUMMARY_LIVE=1

# ========== 外部服务 ==========
# LLM live 需 DeepSeek（或改 LLM_DEFAULT_PROVIDER）
DEEPSEEK_API_KEY=
LLM_USE_MOCK=false
LLM_DISABLE_PROXY=true

# ========== 可选 ==========
EXPLORATION_ROUTE_GEOMETRY_CACHE_TTL_SEC=86400
# RESEARCH_PAYMENT_COMMITMENT_ENABLED=1
# RESEARCH_PROTOCOL_ENABLED=1

# ========== Travel Context 持久化（RFC-003 Phase 5–7）==========
# 详见 .env.travel-context.example
# TRAVEL_CONTEXT_JOURNAL_MEMORY=0
# TRAVEL_CONTEXT_SNAPSHOT_ARCHIVE_READ=1
# TRAVEL_CONTEXT_SNAPSHOT_ARCHIVE_MEMORY=0

# ========== 前端（Vite 工程，若有）==========
# VITE_EXPLORATION_USER_CONDITIONS=1
# VITE_EXPLORATION_RESEARCH_MODE=0
