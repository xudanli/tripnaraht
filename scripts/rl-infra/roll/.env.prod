# ROLL production environment defaults
RAY_NAMESPACE=tripnara-rl-prod
ROLL_BRIDGE_PORT=8001
ROLL_BRIDGE_TIMEOUT_MS=10000
LOG_LEVEL=INFO

# Worker sizing (prod baseline)
ROLL_ACTOR_WORKER_NUM=4
ROLL_REWARD_WORKER_NUM=4
ROLL_POLICY_WORKER_NUM=2

# Guard rails: disable simulation, allow controlled fallback
ROLL_ENABLED=true
ROLL_POLICY_ENABLED=true
ROLL_STRICT_MODE=true
ROLL_ALLOW_SIMULATION=false
ROLL_ALLOW_FALLBACK=true
