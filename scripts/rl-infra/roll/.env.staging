# ROLL staging environment defaults
RAY_NAMESPACE=tripnara-rl-staging
ROLL_BRIDGE_PORT=8001
ROLL_BRIDGE_TIMEOUT_MS=10000
LOG_LEVEL=INFO

# Worker sizing (staging baseline)
ROLL_ACTOR_WORKER_NUM=2
ROLL_REWARD_WORKER_NUM=2
ROLL_POLICY_WORKER_NUM=1

# Strict chain requirement: forbid local simulation
ROLL_ENABLED=true
ROLL_POLICY_ENABLED=true
ROLL_STRICT_MODE=true
ROLL_ALLOW_SIMULATION=false
ROLL_ALLOW_FALLBACK=false
