# Decision Runtime production flags (copy into .env or use deploy script)
# Safe to commit — no secrets.
#
# Apply: npm run gate1:deploy-prod-flags -- --local
# Remote: npm run gate1:deploy-prod-flags -- --remote
#
# Causal Travel Runtime (P0–P5) 完整说明：config/causal-travel-runtime.env.example

# --- Travel Event Store + Gate1 runtime ---
TRAVEL_EVENT_STORE_ENABLED=true
RUNTIME_EVENT_OUTBOX_ENABLED=true
GATE1_LINKED_TRIP_AUTO_CREATE=true
GATE1_TRIP_STATUS_SYNC=true
RUNTIME_OUTBOX_CRON_ENABLED=true
DECISION_RUNTIME_READ_FROM_PROJECTION=false
RUNTIME_REPLAY_VALIDATION=true

# --- Causal Travel Runtime P0–P5 ---
# 三人格读 Decision Kernel，跳过并行 LLM guardian eval
CAUSAL_PERSONA_KERNEL=1
# OPS outcome 回填后自动关闭反事实环（需客户端回传 state + causality_id）
CAUSAL_COUNTERFACTUAL_ON_OPS_OUTCOME=1
# generate-plan 预测快照 + outcome 回填（需 ops_reality_audit_snapshots migration）
OPS_REALITY_AUDIT=1
