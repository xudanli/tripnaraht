# =============================================================================
# Causal Travel Runtime (P0–P5) — 环境变量模板
# =============================================================================
# 用法：
#   cp config/causal-travel-runtime.env.example .env.causal
#   将下方块合并进 .env，或：set -a && source .env.causal && set +a
#
# 文档：docs/decision-os-frontend-integration.md §13
# 生产基线另见：config/runtime-prod.env.example
# =============================================================================

# -----------------------------------------------------------------------------
# P0 — Travel Event Store（因果记录 dual-write）
# -----------------------------------------------------------------------------
# true  ：decision causality + counterfactual outcome 写入 travel_events 表
# false ：仅内存 emit，fail-open（本地默认）
TRAVEL_EVENT_STORE_ENABLED=false

# -----------------------------------------------------------------------------
# P1–P2 — Decision Engine / Iceland 因果（无独立开关，随 generate-plan 运行）
# -----------------------------------------------------------------------------
# 冰岛 benchmark（开发/CI 可选）：
#   npm run decision-os:iceland-benchmark

# -----------------------------------------------------------------------------
# P3 — 三人格共享因果 Kernel（Agent 只叙事，不并行 LLM guardian eval）
# -----------------------------------------------------------------------------
# 1 / true  ：kernelAuthoritative 时 PersonaShell + TripPlanner 跳过 LLM guardian
# 0 / false ：回退 legacy 启发式 + LLM 评估路径
CAUSAL_PERSONA_KERNEL=1
# 别名（与上相同，二选一即可）
# TRIP_CAUSAL_PERSONA_KERNEL=1

# -----------------------------------------------------------------------------
# P4 — Gate1 履约因果 / Trust Surface（无独立开关，trust-surface API 随数据启用）
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# P5 — 反事实闭环 + OPS 回填自动触发
# -----------------------------------------------------------------------------

# P-OPS-2：generate-plan 时写入 ops_reality_audit_snapshots；outcome 回填 API 可用
# 需 DB migration（ops_reality_audit_snapshots 表）
OPS_REALITY_AUDIT=0

# OPS outcome 成功后，若请求带 causality_id + state，自动跑 P5 counterfactual closure
# 1（默认）：开启
# 0：仅手动 POST /decision-engine/v1/causal-outcome
CAUSAL_COUNTERFACTUAL_ON_OPS_OUTCOME=1
# 别名
# TRIP_CAUSAL_COUNTERFACTUAL_OPS=1

# Agent / decision-engine 服务端会话：generate-plan 后缓存 TripWorldState，OPS outcome 自动 join
# 默认 7 天 TTL；单进程内存（多实例部署仍需客户端或 Redis 扩展）
# CAUSAL_RUNTIME_SESSION_TTL_MS=604800000
# CAUSAL_RUNTIME_SESSION_MAX_ENTRIES=500

# -----------------------------------------------------------------------------
# 可选 — ECO 认知管道（reflectiveCausalModel 深度修订，与 P5 轻量校准互补）
# -----------------------------------------------------------------------------
# 1：强制跑 execution-cognitive-orchestrator P9/P10
# 未设置时：仅当 policies.ecoPipeline 等为 true 时运行
# TRIP_ECO_PIPELINE=0

# -----------------------------------------------------------------------------
# 推荐组合
# -----------------------------------------------------------------------------

# --- 本地开发（最小）---
# TRAVEL_EVENT_STORE_ENABLED=false
# CAUSAL_PERSONA_KERNEL=1
# CAUSAL_COUNTERFACTUAL_ON_OPS_OUTCOME=1
# OPS_REALITY_AUDIT=0

# --- Staging / 联调因果闭环 ---
# TRAVEL_EVENT_STORE_ENABLED=true
# CAUSAL_PERSONA_KERNEL=1
# CAUSAL_COUNTERFACTUAL_ON_OPS_OUTCOME=1
# OPS_REALITY_AUDIT=1
# DATABASE_URL=postgresql://...

# --- Production（与 Gate1 runtime 一并部署）---
# TRAVEL_EVENT_STORE_ENABLED=true
# RUNTIME_EVENT_OUTBOX_ENABLED=true
# CAUSAL_PERSONA_KERNEL=1
# CAUSAL_COUNTERFACTUAL_ON_OPS_OUTCOME=1
# OPS_REALITY_AUDIT=1
# 见 config/runtime-prod.env.example
