# Agent Harness 生产/预发推荐变量（追加到 .env 或平台 Secret）
# 说明：internal-docs/orchestration/harness-trace-deploy-runbook.md
# Checklist：internal-docs/orchestration/harness-production-checklist.md

# ── Agent Harness P0-1 W0：统一写链强制（代码默认已 ON/ENFORCE；显式写出防漂移）──
EFFECTIVE_PLAN_WRITE_CHAIN=1
EFFECTIVE_PLAN_WRITE_GUARD=ENFORCE
# 仅单测/本地逃生：ALLOW_WRITE_CHAIN_OFF=1

# ── Observability P0：失败黑匣子 trace（成功路径零 append 开销）──
HARNESS_TRACE_MODE=on-failure
HARNESS_TRACE_EXPORT_DIR=artifacts/harness-on-failure
# HARNESS_TRACE_EXPORT_FLAT=1

# ── Control P0/P1：Agentic MCP 治理 + token 配额 ──
# destructive 工具基线（delete/send 等）始终 ask/deny，无需开 HITL
FEATURE_AGENTIC_GOVERNANCE_HITL=1
AGENTIC_LOOP_MAX_TOTAL_TOKENS=4000
AGENTIC_LOOP_MIN_REMAINING_MS=800
# 日配额（0 或未设 = 不启用）；生产建议先设 per-user，再视情况加 global
# AGENTIC_DAILY_TOKEN_QUOTA_PER_USER=200000
# AGENTIC_DAILY_TOKEN_QUOTA_PER_ORG=2000000   # B2B 租户 org 级日 token 上限
# AGENTIC_DAILY_TOKEN_QUOTA_GLOBAL=2000000
# AGENTIC_SESSION_TOKEN_CAP=8000          # 单会话 token 上限（overnight burn 防护）

# ── State P0：PA 多轮会话（多 Pod 必开 Redis，勿 DISABLE_REDIS）──
# REDIS_HOST=...
# REDIS_PORT=6379

# ── State P1：conversation_context 滑动窗口（Gateway 入口 default=10；staging 可调参）──
# CONTEXT_WINDOW_DEFAULT_LIMIT=10
# CONTEXT_WINDOW_ORCHESTRATOR_CLAUDE_LIMIT=16
# CONTEXT_WINDOW_INTENT_COMPILER_LIMIT=3

# ── State P2：Agentic loop 每步 checkpoint（HITL ask hold 可续跑）──
# AGENTIC_LOOP_CHECKPOINTS=0   # 关闭 checkpoint 落 trace
# HARNESS_EXECUTION_POLICY_EXTERNAL_API=1   # external API DSL enforce（默认 observe）
# HARNESS_COST_ALERT_GLOBAL_QUOTA_PCT=90     # global daily token 用量告警阈值（%）
# HARNESS_COST_ALERT_DAILY_USD=50           # 今日 LLM 成本 spike 告警（USD，0=关）
# 续跑：options.agentic_resume_checkpoint_v1 ← trace.checkpoints 末条

# ── Observability P3：Shadow Grader（异步，不阻塞 route_and_run）──
# HARNESS_SHADOW_GRADER=1
# SHADOW_GRADER_ENABLED=1          #  legacy 别名
# DECISION_TRAJECTORY_ENABLED=1    #  在线 trajectory finalize → scheduleGradeFromTrajectory
# 注册 active shadow：POST /api/admin/diagnostics/harness/shadow-grader/register
# 或 CLI：tripnara harness shadow-grader register --task-id ... --adapter-path ...
# 响应：observability.shadow_grader_v1.scheduled / skip_reason / aggregate.win_rate

# ── Control P3：Subagent 权限沙箱（message escalation 剥离 + MCP cap）──
# HARNESS_SUBAGENT_SANDBOX=1
# 响应：observability.subagent_permission_sandbox_v1

# ── State P3：情景 memory 异步 summarizer（长 session 压缩）──
# HARNESS_EPISODIC_SUMMARIZER=1
# HARNESS_EPISODIC_SUMMARIZE_MIN_MESSAGES=8
# HARNESS_EPISODIC_COMPACTION_KEEP_RECENT=4
# HARNESS_EPISODIC_SUMMARIZER_LLM=1       # 可选 LLM 摘要（失败回落 deterministic）
# 响应：observability.episodic_summarizer_v1

# ── 决策闭环 / 路政物化（前端 L1 Banner + explain.optimization）──
DECISION_OS_RAG_EVIDENCE_ENABLED=true

# 单请求 observability.llm_routing_v1：providers_used / multi_provider_request / calls_by_provider

# ── Control：Kernel 硬门禁（运维签字后生产启用）──
# 签字流程见 internal-docs/orchestration/harness-kernel-hard-runbook.md
# HARNESS_SHADOW_AFTER_PHASE=1              # staging 观测 shadow 指标
# HARNESS_SHADOW_CONSECUTIVE_THRESHOLD=100  # sign_off_eligible 阈值
# HARNESS_KERNEL_SHADOW_STRICT=1             # 预发演练 strict（须配合 SHADOW_AFTER_PHASE）
# HARNESS_KERNEL_HARD=1                     # 生产硬门禁（隐含 shadow + strict）

# ── Observability：在线质量环 runtime 采样（可选）──
# HARNESS_QUALITY_SAMPLE_RATE=0.01
# batch：npm run harness:quality-loop

# ── Observability：Badcase catalog（on-failure trace → 可检索 index）──
# HARNESS_BADCASE_CATALOG_DIR=artifacts/harness-badcases
# cron: bash scripts/collect-harness-badcases.sh

# ── CI / 合入前（与 npm run harness:l1-smoke 一致）──
# ORCHESTRATOR_CONTEXT_LINT_ENABLED=1
# ORCHESTRATOR_CONTEXT_LINT_STRICT=1
