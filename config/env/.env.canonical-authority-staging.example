# Canonical Authority — Staging Rollout（按 Phase 启用一块，勿一次全开）
# 文档：src/decision-runtime/CANONICAL_AUTHORITY_AUDIT.md §13
# 验证：npm run harness:authority

# =============================================================================
# Day 0 — 基线（Staging 建议始终保留）
# =============================================================================

LEGACY_MUTATION_WRITE_GUARD=ENFORCE
ASYNC_MUTATION_WRITE_GUARD=ENFORCE
AGENTIC_MUTATION_WRITE_GUARD=ENFORCE
EFFECTIVE_PLAN_WRITE_CHAIN=1
# Agent Harness P0-1 W0：GUARD 全环境默认 ENFORCE（代码未设时亦 ENFORCE）
EFFECTIVE_PLAN_WRITE_GUARD=ENFORCE

# RFC001 非 shadow（与 Iceland harness 一致）
RFC001_SHADOW_MODE=0

# =============================================================================
# Phase 1 — Effective Plan Write Guard 观测（历史；P0-1 W0 后默认 ENFORCE）
# 仅诊断时可临时 SHADOW（须配合 ALLOW_WRITE_CHAIN_OFF=1 若同时关 CHAIN）
# =============================================================================

# EFFECTIVE_PLAN_WRITE_GUARD=SHADOW

# =============================================================================
# Phase 2 — Effective Plan Write Guard ENFORCE（已并入 Day 0 / W0）
# =============================================================================

# （见上方 EFFECTIVE_PLAN_WRITE_GUARD=ENFORCE）
# =============================================================================
# Phase 3 — Constraint Gateway 双轨观测（Week 3）
# Legacy 仍为 authority；采集 canonical vs legacy divergence
# =============================================================================

# CONSTRAINT_GATEWAY_MODE=SHADOW_COMPARE
# CONSTRAINT_EVALUATION_GATEWAY_ENABLED=1

# =============================================================================
# Phase 4 — Gateway 选择性权威（Week 4–5）
# 先冰岛道路封闭，稳定后再扩展 ON_SCENARIOS
# =============================================================================

# CONSTRAINT_GATEWAY_MODE=ON_FOR_SELECTED
# CONSTRAINT_GATEWAY_ON_SCENARIOS=iceland-road-closed
# 扩展（每 scenario ≥3 天观察）：
# CONSTRAINT_GATEWAY_ON_SCENARIOS=iceland-road-closed,weather-outdoor-storm
# Sprint B — Travel Ontology 约束（staging 灰度，在 legacy 场景稳定后追加）：
# CONSTRAINT_GATEWAY_ON_SCENARIOS=iceland-road-closed,iceland-ontology-vehicle-route,iceland-ontology-insurance-entry

# =============================================================================
# Phase 5 — Gateway 全局权威（Week 6+，勿在 Staging 抢跑）
# =============================================================================

# CONSTRAINT_GATEWAY_MODE=ON
# DECISION_RUNTIME_MODE=CANONICAL
# CANONICAL_EXECUTION_ENABLED=1

# =============================================================================
# 观测辅助（可选，与 .env.production-transition.example 对齐）
# =============================================================================

# DECISION_TRIGGER_GATEWAY_ENABLED=1
# AUTHORIZATION_POLICY_GATEWAY_ENABLED=1
# REPLANNING_TRIGGER_POLICY_ENABLED=1

# =============================================================================
# Rollback 速查（恢复上一 Phase 时只改主 flag）
# =============================================================================
# Phase 5 → ON_FOR_SELECTED + 缩小 ON_SCENARIOS
# Phase 4 → SHADOW_COMPARE
# Phase 3 → CONSTRAINT_GATEWAY_MODE=OFF
# P0-1 W0：勿将 EFFECTIVE_PLAN_WRITE_GUARD/CHAIN 设为 OFF（测试逃生用 ALLOW_WRITE_CHAIN_OFF=1）
