# Unified Decision API — 前端联调 / Staging 推荐变量
# 用法：将下方块追加到 .env，或复制到平台 Secret；重启 `npm run dev`
# 文档：src/trips/decision-semantics/UNIFIED_DECISION_FRONTEND_INTEGRATION.md

# ── 必开（Gateway + Canonical L2 三 Slice）──
DECISION_GATEWAY_UNIFIED=1
CANONICAL_ROAD_SEGMENT_UNAVAILABLE=1
CANONICAL_WEATHER_ACTIVITY_PROHIBITED=1
CANONICAL_EXCESSIVE_DAILY_LOAD=1
RFC001_SHADOW_MODE=0

# ── 推荐（Pack 元数据 + 规则评估）──
DECISION_PACK_RUNTIME=1
DECISION_PACK_RULES=1

# ── Production Transition 观察窗（Layer 1 Trigger 12/12 dispatch 已收口）──
# 完整说明：.env.production-transition.example · src/decision-runtime/PRODUCTION_TRANSITION.md
# DECISION_TRIGGER_GATEWAY_ENABLED=1
# DECISION_TRIGGER_LINEAGE_ENABLED=1
# CONSTRAINT_GATEWAY_MODE=SHADOW_COMPARE
# AUTHORIZATION_POLICY_GATEWAY_ENABLED=1
# REPLANNING_TRIGGER_POLICY_ENABLED=1
# LEGACY_CONVERGENCE_TARGET=CANONICAL_SELECTIVE

# ── 可选 ──
# RFC001_V15_PROJECTION=1          # L1 overview 镜像 Canonical 决策
# RFC001_ITINERARY_MATERIALIZE=1   # execute 后写回行程实体

# ── 前端 repo（Vite）──
# VITE_DECISION_GATEWAY_UNIFIED=1

# ── 联调验证 ──
# npm run rfc002:fe-readiness
# npm run decision-center:unified-env-check
# npm run decision-center:unified-qa -- 3e4a1058-9218-467f-988a-c18008a14385
