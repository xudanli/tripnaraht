# RFC-003 Travel Context Protocol — 持久化与读缓存（复制到 .env）
# 探针：npm run probe:travel-context-storage -- <tripId>
# 迁移（若表未建）：
#   npx prisma db execute --file prisma/migrations/add_travel_context_revision_journal.sql --schema prisma/schema.prisma
#   npx prisma db execute --file prisma/migrations/add_travel_context_snapshot_archive.sql --schema prisma/schema.prisma

# ========== Phase 5 — Revision diff journal ==========
# 0 / unset：Intent 产生的 diff 写入 PostgreSQL travel_context_revision_journal（推荐）
# 1：仅进程内存（重启后 GET /diff 可能 requiresFullRefresh；单测 / 调试）
TRAVEL_CONTEXT_JOURNAL_MEMORY=0

# ========== Phase 7 — Snapshot 归档 ==========
# 1：build(contextId) 优先从 travel_context_snapshot_archive 读缓存（revision 未变时跳过完整 assemble）
# 0：每次全量 assemble（仍会在 assemble / Intent 后写入 archive）
# 未设置时：production 默认开启读缓存，其它环境默认关闭
TRAVEL_CONTEXT_SNAPSHOT_ARCHIVE_READ=1

# 1：snapshot archive 仅内存，不落库
# 0 / unset：写入 PostgreSQL travel_context_snapshot_archive（推荐）
TRAVEL_CONTEXT_SNAPSHOT_ARCHIVE_MEMORY=0

# ========== 联调 fixture seed（可选）==========
# FIXTURE_OWNER_USER_ID=5872f534-4fdf-483d-9e5a-464d3f36935d
# npm run seed:iceland-unified-decision-fixture
