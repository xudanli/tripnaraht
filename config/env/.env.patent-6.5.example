# 专利 6.5 对齐 — 环境变量模板（复制到 .env 或 source scripts/setup-patent-6.5-env.sh）
# 文档：.pr/patent-6.5-alignment.md

# 决策内核主路径
DECISION_KERNEL_ENABLED=true
KERNEL_NATIVE_EXECUTION=true
KERNEL_NATIVE_EXECUTION_GRAY_PERCENT=100

# PR-1：beliefSamples → patentParticlesView
DECISION_OS_PATENT_PARTICLES_VIEW=1

# PR-2：PLAN_GEN 多候选 → DSO.candidates
DECISION_OS_PATENT_PLAN_GEN_CANDIDATES=1

# PR-4：INTAKE 年龄/体能 → 约束种子
DECISION_OS_PATENT_INTAKE_NORMALIZER=1

# PR-4：GATE_EVAL 专利约束扩展
DECISION_OS_PATENT_GATE_CONSTRAINTS=1

# PR-4：FEEDBACK 在线学习 + Lyapunov 审计
DECISION_OS_PATENT_FEEDBACK_LEARNING=1

# 可选：NZ 5 天 mock 回归（scripts/replay-patent-nz-5day.ts）
# npm run test:patent-nz-5day
