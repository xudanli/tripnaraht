# Decision OS 生产/预发推荐变量（追加到 .env 或平台 Secret）
# 详见 docs/decision-os-env-gates.md

# ============================================
# PRD 3.1.3 身份资产授信网关（Odyssey Intake / Match Square）
# 完整说明：internal-docs/odyssey-intake/credential-gateway-production.md
# PRD 归档：internal-docs/odyssey-intake/prd-3.1.3-asset-verification-privacy.md
# ============================================
#
# 本地联调三步：
#   1. npm run credential:mock-gateway          # 启动 http://127.0.0.1:3099
#   2. 取消下方注释并写入 .env
#   3. curl /api/odyssey-intake/credentials/gateway/status
#
# CREDENTIAL_VERIFICATION_MODE=hybrid
# CREDENTIAL_GATEWAY_API_KEY=dev-mock-key
# CREDENTIAL_GATEWAY_HTTP_TIMEOUT_MS=8000
# CREDENTIAL_GATEWAY_HTTP_MAX_RETRIES=3
#
# CREDENTIAL_XUEXIN_GATEWAY_URL=http://127.0.0.1:3099/chsi
# CREDENTIAL_MAIL_GATEWAY_URL=http://127.0.0.1:3099/mail
# CREDENTIAL_MAIL_FROM=verify@tripnara.com
# CREDENTIAL_EMAIL_OTP_TTL_SECONDS=600
# CREDENTIAL_OAUTH_GATEWAY_URL=http://127.0.0.1:3099/oauth
# CREDENTIAL_BADGE_OCR_GATEWAY_URL=http://127.0.0.1:3099/badge-ocr
# CREDENTIAL_BADGE_UPLOAD_TTL_SECONDS=900
# CREDENTIAL_MOCK_GATEWAY_PORT=3099
#
# 生产环境将 URL 换为真实合规网关，并设置强随机 CREDENTIAL_GATEWAY_API_KEY：
# CREDENTIAL_XUEXIN_GATEWAY_URL=https://compliance-gateway.internal/chsi
# CREDENTIAL_MAIL_GATEWAY_URL=https://compliance-gateway.internal/mail
# CREDENTIAL_OAUTH_GATEWAY_URL=https://compliance-gateway.internal/oauth
# CREDENTIAL_BADGE_OCR_GATEWAY_URL=https://compliance-gateway.internal/badge-ocr
#
# 工牌未配外部 OCR 网关时需 GOOGLE_VISION_API_KEY（见 .env 地图/OCR 块）

# PHYSICAL 决策 evidenceRefs 分级门禁（CI/预发/生产推荐）
PHYSICAL_EVIDENCE_GATE=error_critical_stages

# traceability errors 时跳过 DecisionLog 持久化（预发建议开启）
# DECISION_LOG_STRICT_WRITE=1

# POMDP 精炼指标 JSON log（离线 calibrate:pomdp-thresholds 输入）
# POMDP_METRICS=1

# unified explainability 叙事漂移 metrics（route_and_run observability.narrative_drift + JSON log）
# NARRATIVE_DRIFT_METRICS_LOG=1
# NARRATIVE_DRIFT_METRICS_LOG_FILE=/path/to/app.log

# PRD 4.3 Vibe LLM 动态意图解析（Match Square 发布页）
# 默认开启 LLM 语义解析 + 规则校准；本地/CI 纯规则测试可设 VIBE_LLM_ENABLED=false
# VIBE_LLM_ENABLED=false
# VIBE_LLM_PROVIDER=deepseek
