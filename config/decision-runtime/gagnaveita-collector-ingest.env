# Gagnaveita remote collector — TripNARA ingest gate (contract v1)
# Share secret with Frankfurt ECS collector host.
# Falls back to VEDUR_COLLECTOR_HMAC_SECRET when GAGNAVEITA_COLLECTOR_HMAC_SECRET unset.

GAGNAVEITA_COLLECTOR_INGEST_ENABLED=1
GAGNAVEITA_COLLECTOR_INGEST_CANONICAL=1
GAGNAVEITA_COLLECTOR_ALLOWED_IDS=gagnaveita-collector-pilot
GAGNAVEITA_COLLECTOR_SIGNATURE_WINDOW_SEC=300
