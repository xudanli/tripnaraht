# Slice 4 Internal Dual-Read + Weather Continuous Live Allowlist
# Apply on Nest :3002. Primary SSO / visible queue cutover / Road promotion remain OFF.

# --- Weather Auto-Promotion (continuous live, allowlist only) ---
ASSERTION_PROMOTION_ENABLED=1
ASSERTION_PROMOTION_SHADOW_MODE=0
ASSERTION_PROMOTION_WEATHER_ENABLED=1
ASSERTION_PROMOTION_ROAD_ENABLED=0
ASSERTION_PROMOTION_TRIP_ALLOWLIST=a0a99999-9999-4999-8999-999999999999,c0c77777-7777-4777-8777-777777777777
ASSERTION_PROMOTION_INTERNAL_SECRET=shadow-promotion-devbox-2026-07-12
ASSERTION_PROMOTION_BASE_URL=http://127.0.0.1:3002
ASSERTION_PROMOTION_RETRY_INTERVAL_MS=300000
ASSERTION_PROMOTION_MAX_ATTEMPTS=5
ASSERTION_PROMOTION_RETRY_CRON_ENABLED=1
ASSERTION_PROMOTION_TEST_FAIL_ONCE=0

# --- Slice 4 Internal Dual-Read (NOT Primary SSO) ---
ATTENTION_ROOT_CAUSE_ORCHESTRATION=1
ATTENTION_ROOT_CAUSE_PRIMARY_SSO=0
ATTENTION_INTERNAL_DUAL_READ_ENABLED=1
ATTENTION_INTERNAL_DUAL_READ_TRIP_ALLOWLIST=c0c77777-7777-4777-8777-777777777777,a0a99999-9999-4999-8999-999999999999
ATTENTION_INTERNAL_DUAL_READ_USER_IDS=c0c77777-7777-4777-8777-777777777701
ATTENTION_INTERNAL_DUAL_READ_EMAIL_DOMAINS=tripnara.dev

