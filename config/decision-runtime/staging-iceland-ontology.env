# Iceland Travel Ontology — Staging Gateway Rollout
# 用法：与 .env.canonical-authority-staging.example Phase 4 合并 deploy
# 前置：CONSTRAINT_GATEWAY_MODE=ON_FOR_SELECTED 已开启

CONSTRAINT_GATEWAY_MODE=ON_FOR_SELECTED
CONSTRAINT_EVALUATION_GATEWAY_ENABLED=1

# 在既有 legacy 场景稳定后追加 ontology 条目（勿单独全开）
CONSTRAINT_GATEWAY_ON_SCENARIOS=iceland-road-closed,iceland-ontology-vehicle-route,iceland-ontology-insurance-entry

# ontology 场景说明：
# - iceland-ontology-vehicle-route → VEHICLE_CAPABILITY_MISMATCH, RENTAL_CONTRACT_ROAD_PROHIBITION
# - iceland-ontology-insurance-entry → ENTRY_ELIGIBILITY_UNKNOWN, VISA_STATUS_UNCONFIRMED, INSURANCE_*
