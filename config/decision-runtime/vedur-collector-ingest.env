# Vedur remote collector — TripNARA ingest gate (contract v1)
# Enable after SPIKE_PASS on Frankfurt ECS (47.87.131.183).
# Share VEDUR_COLLECTOR_HMAC_SECRET with collector host only.

VEDUR_COLLECTOR_INGEST_ENABLED=1
