+  conceptual: string;
+  actual: string;
+  scope: string;
+  notes: string;
+};
+
+/**
+ * 当前不存在贯穿整个智能体主链的统一 `contextHash`。
+ * 近邻字段：snapshotId / contextVersion / expected_negotiation_hash / effectivePlanVersionId。
+ */
