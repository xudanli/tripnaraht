# Decision Runtime — Production Transition（30d 观察窗）
# 用法：将对应阶段块追加到 .env，或复制为 .env.production-transition.local
# 文档：src/decision-runtime/PRODUCTION_TRANSITION.md
# 运维：npm run trigger-wiring:status · npm run production-observation:report · npm run p5-weekly-ops

# =============================================================================
# Formal phase — Engineering Complete, Production Observation active
# =============================================================================
DECISION_RUNTIME_PHASE=PRODUCTION_OBSERVATION
CURRENT_AUTHORITY=LEGACY
CANONICAL_ROLLOUT=SELECTIVE
LEX_ROLE=SHADOW_ONLY

# =============================================================================
# 阶段 A — 生产观察窗（推荐当前启用）
# Legacy optimization / boolean 仍为 Authority；仅采集 Gateway + SHADOW 指标
# =============================================================================

DECISION_TRIGGER_GATEWAY_ENABLED=1
DECISION_TRIGGER_LINEAGE_ENABLED=1

# Constraint：双跑观测，不改变生产 Authority
CONSTRAINT_GATEWAY_MODE=SHADOW_COMPARE
CONSTRAINT_EVALUATION_GATEWAY_ENABLED=1

# 授权 / 重规划：记录 Gateway 决策，观察期不强制改变执行路径
AUTHORIZATION_POLICY_GATEWAY_ENABLED=1
REPLANNING_TRIGGER_POLICY_ENABLED=1

# 观察期勿开：自动局部修复 / Monitoring 默认重规划
# BOUNDED_LNS_REPAIR_ENABLED=0

# 收敛目标（观察期保持 selective，勿切 CANONICAL_DEFAULT）
LEGACY_CONVERGENCE_TARGET=CANONICAL_SELECTIVE

# 观察窗与报告 CLI
CANONICAL_DEFAULT_MIN_OBSERVATION_DAYS=30
DECISION_RUNTIME_BASE_URL=http://localhost:3000/api
# PRODUCTION_OBSERVATION_STRICT=1

# Shadow 指标（保持开启）
# OPTIMIZATION_SHADOW_METRICS_DISABLED=0

# =============================================================================
# 阶段 B — 本地 selective 全量探针（npm run p4-selective:dev-3000 已内置，一般无需手写）
# =============================================================================
# DECISION_RUNTIME_MODE=SHADOW
# CONSTRAINT_GATEWAY_MODE=ON_FOR_SELECTED
# CONSTRAINT_GATEWAY_ON_SCENARIOS=iceland-road-closed,weather-outdoor-storm,daily-load-excessive,in-trip-replan,full-plan-selection,guide-plan-selection,opening-hours-conflict
# BOUNDED_LNS_REPAIR_ENABLED=1

# =============================================================================
# 阶段 C — 生产 CANONICAL_DEFAULT flip（观察窗 PASS + 人工签字后）
# 详见：src/decision-runtime/p4-phase/CANONICAL_DEFAULT_PRODUCTION_FLIP.md
# 生产环境执行 advisory 时勿设 P4_FLIP_DEV_DRILL=1
# =============================================================================
# DECISION_RUNTIME_MODE=CANONICAL
# CONSTRAINT_GATEWAY_MODE=ON_FOR_SELECTED
# CANONICAL_FULL_PLAN_SELECTION=1
# CANONICAL_EXECUTION_ENABLED=1
# LEGACY_CONVERGENCE_TARGET=CANONICAL_DEFAULT
# OPTIMIZATION_STRATEGY_MODE=AUTO

# =============================================================================
# M7 内部触发中心预览
# =============================================================================
# M7_PREVIEW_PORT=8090
# npm run m7-trigger-center:preview
