[
  {
    "rule_id": "comp_001",
    "type": "COMPLIANCE",
    "name": "GDPR data handling",
    "description": "Ensure GDPR compliance for EU users",
    "condition": {
      "user_location": {
        "in": ["EU"]
      }
    },
    "severity": "HARD",
    "sev_level": "SEV-1",
    "action": "BLOCK",
    "metadata": {
      "category": "LEGAL"
    }
  },
  {
    "rule_id": "comp_002",
    "type": "COMPLIANCE",
    "name": "Data retention policy",
    "description": "Ensure data retention compliance",
    "condition": {
      "data_retention_required": {
        "eq": true
      }
    },
    "severity": "SOFT",
    "sev_level": "SEV-3",
    "action": "WARN",
    "metadata": {
      "category": "LEGAL"
    }
  }
]
