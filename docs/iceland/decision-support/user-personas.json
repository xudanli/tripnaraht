  "matching_algorithm": {
    "step_1_user_profiling": {
      "description": "通过问卷或行为数据，识别用户当前状态",
      "key_questions": [
        "这是您第几次来冰岛？",
        "您有多少天时间？",
        "您的预算范围是？",
        "您追求舒适还是冒险？",
        "您带孩子或老人吗？",
        "您对摄影/极光/文化/户外哪个最感兴趣？"
      ]
    },
    "step_2_dimension_scoring": {
      "description": "给用户在8个维度上打分",
      "dimensions": {
        "travel_experience": {"beginner": 0, "intermediate": 0.5, "advanced": 1},
        "risk_tolerance": {"very_low": 0, "low": 0.25, "medium": 0.5, "high": 0.75, "very_high": 1},
        "comfort_need": {"very_low": 0, "low": 0.25, "medium": 0.5, "high": 0.75, "very_high": 1},
        "adventure_spirit": {"very_low": 0, "low": 0.25, "medium": 0.5, "high": 0.75, "very_high": 1}
      }
    },
    "step_3_persona_matching": {
      "description": "计算用户与各persona的相似度",
      "formula": "similarity = 1 - sqrt(sum((user_dimension - persona_dimension)^2)) / sqrt(8)",
      "threshold": "相似度 > 0.7 认为匹配"
    },
    "step_4_route_recommendation": {
      "description": "根据匹配的persona推荐路线",
      "logic": "persona.suitable_routes按fit_score排序"
    },
    "step_5_rhythm_matching": {
      "description": "匹配合适的节奏模式",
      "mapping": {
        "首次探索者": "轻松观光节奏",
        "摄影追光者": "摄影追逐节奏",
        "冒险挑战者": "探险挑战节奏",
        "家庭亲子游": "家庭友好节奏",
        "预算背包客": "轻松观光节奏",
        "文化深度游": "文化沉浸节奏",
        "轻奢度假者": "轻松观光节奏（高端）"
      }
    }
  },
