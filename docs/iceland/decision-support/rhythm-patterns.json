    "purpose": "定义路线的节奏模式，用于匹配用户状态和路线特征"
  },
  "rhythm_framework": {
    "definition": "节奏是路线的'呼吸'方式，描述路线的强度、变化和恢复模式",
    "core_philosophy": "不同的节奏适合不同的用户状态，没有'最好'的节奏，只有'合适'的节奏",
    "three_dimensions": {
      "pace": {
        "definition": "路线的整体速度和密度",
        "levels": ["slow", "moderate", "fast"],
        "measurement": "景点密度、停留时间、行程紧凑度"
      },
      "intensity_variation": {
        "definition": "强度变化的剧烈程度",
        "levels": ["consistent", "gradual", "dramatic"],
        "measurement": "体能需求波动、决策压力变化"
      },
      "recovery_time": {
        "definition": "路线提供的恢复和休息机会",
        "levels": ["minimal", "moderate", "ample"],
        "measurement": "休息点频率、可调节性"
      }
    }
  },
