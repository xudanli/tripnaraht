    }
  },
  "accessibility_scoring_algorithm": {
    "formula": "accessibility_score = base_score × seasonal_factor × weather_factor × vehicle_factor",
    "factors": {
      "seasonal_factor": {
        "optimal_season": 1.0,
        "shoulder_season": 0.7,
        "off_season": 0.3,
        "impossible_season": 0.0
      },
      "weather_factor": {
        "clear": 1.0,
        "moderate": 0.8,
        "severe_weather": 0.3,
        "extreme_weather": 0.0
      },
      "vehicle_factor": {
        "has_required_vehicle": 1.0,
        "missing_required_vehicle": 0.0
      }
    },
    "interpretation": {
      "accessibility_score_1.0": "完全可达",
      "accessibility_score_0.7_to_0.9": "可达但有限制",
      "accessibility_score_0.3_to_0.6": "勉强可达，需专业技能",
      "accessibility_score_0.0_to_0.2": "不可达或极度危险"
    }
  },
  "decision_support_integration": {
    "use_in_feasibility_matrix": "可达性评分是可行性评分的关键输入",
    "if_accessibility_0.0": "可行性自动降至0（不可行）",
    "if_accessibility_0.3_to_0.6": "可行性显著降低，需警告用户",
    "if_accessibility_0.7_to_0.9": "可行性适度降低",
    "if_accessibility_1.0": "可达性不影响可行性"
  },
