      "road_number": "1号公路/F208等",
      "section": "路段描述",
      "closure_reason": "暴风雪|洪水|雪崩|火山|维护",
      "start_time": "ISO 8601格式",
      "estimated_reopening": "ISO 8601格式或unknown",
      "alternative_routes": ["替代路线1", "替代路线2"],
      "affected_itineraries": ["route_id_001"],
      "recommendations": [
        "推荐行动"
      ],
      "source": "Road.is",
      "last_updated": "ISO 8601格式"
    },
    "volcano_alert_template": {
      "alert_id": "VA-{timestamp}-{volcano_name}",
      "alert_type": "volcano",
      "severity": "critical|severe|moderate|advisory",
      "volcano_name": "火山名称",
      "alert_level": "绿色|黄色|橙色|红色",
      "event_type": "地震活动|岩浆侵入|爆发|气体排放",
      "location": "坐标",
      "start_time": "ISO 8601格式",
      "exclusion_zone_km": "半径公里数",
      "affected_routes": ["route_id_001"],
      "recommendations": [
        "远离该区域",
        "关注更新"
      ],
      "source": "Icelandic Met Office",
      "last_updated": "ISO 8601格式"
    }
  },
