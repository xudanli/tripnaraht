  "integration_workflow": {
    "step_1_data_fetching": {
      "description": "定期从官方API获取最新警报",
      "frequency": "每15分钟",
      "sources": ["vedur.is", "road.is", "SafeTravel.is"]
    },
    "step_2_alert_parsing": {
      "description": "解析警报数据，提取关键信息",
      "extract": ["severity", "location", "time", "type"]
    },
    "step_3_route_matching": {
      "description": "匹配警报与路线数据",
      "algorithm": "基于地理位置和时间范围匹配"
    },
    "step_4_user_notification": {
      "description": "通知受影响用户",
      "channels": ["应用推送", "邮件", "短信"],
      "priority": {
        "critical": "立即推送",
        "severe": "30分钟内推送",
        "moderate": "2小时内推送",
        "advisory": "不主动推送，用户查询时显示"
      }
    },
    "step_5_feasibility_update": {
      "description": "更新路线可行性评分",
      "impact": {
        "critical": "可行性评分 → 0.0-0.1",
        "severe": "可行性评分 × 0.3",
        "moderate": "可行性评分 × 0.6",
        "advisory": "可行性评分 × 0.9"
      }
    }
  },
  "ai_decision_logic": {
    "when_critical_alert": {
      "action": "主动劝阻用户",
      "message_tone": "严肃、直接、强烈不推荐",
      "feasibility_score": "< 0.15",
      "alternatives": "提供替代路线"
    },
    "when_severe_alert": {
      "action": "警告用户并提供选项",
      "message_tone": "严肃但可选",
      "feasibility_score": "0.2 - 0.4",
      "alternatives": "提供延迟或替代方案"
    },
    "when_moderate_alert": {
      "action": "告知风险，用户决定",
      "message_tone": "客观、透明",
      "feasibility_score": "0.5 - 0.7",
      "alternatives": "可选"
    },
    "when_advisory_alert": {
      "action": "信息性提示",
      "message_tone": "友好、提示性",
      "feasibility_score": "> 0.8",
      "alternatives": "不必需"
    }
  },
  "transparency_principles": {
    "always_show_source": "每条警报必须显示来源",
    "always_show_time": "必须显示警报发布时间",
    "always_explain_impact": "必须解释对用户行程的影响",
    "always_provide_alternatives": "critical/severe警报必须提供替代方案",
    "no_hiding_bad_news": "绝不隐瞒不利信息"
  },
  "data_retention": {
    "active_alerts": "保留至警报解除后24小时",
    "historical_alerts": "永久保留（用于分析）",
    "user_notifications": "保留30天"
  },
