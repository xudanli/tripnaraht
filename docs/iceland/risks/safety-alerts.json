{
  "metadata": {
    "version": "1.0.0",
    "last_updated": "2026-01-23",
    "data_type": "real_time_safety_template",
    "data_sources": [
      "SafeTravel.is API",
      "Icelandic Met Office API",
      "Road.is API",
      "Volcano Alert System"
    ],
    "credibility_score": 0.95,
    "language": "zh-CN",
    "update_frequency": "实时"
  },
  "alert_system_overview": {
    "description": "冰岛实时安全警报系统模板",
    "purpose": "为TripNARA提供实时安全数据接入框架",
    "alert_types": [
      "天气警报",
      "道路关闭警报",
      "火山活动警报",
      "地震警报",
      "雪崩警报",
      "洪水警报"
    ],
    "severity_levels": {
      "critical": "极度危险，禁止出行",
      "severe": "严重危险，强烈不推荐",
      "moderate": "中度危险，需谨慎",
      "advisory": "提示性警报"
    }
  },
  "api_endpoints": {
    "weather_alerts": {
      "provider": "Icelandic Met Office",
      "endpoint": "https://en.vedur.is/weather/forecasts/xml/",
      "update_frequency": "每小时",
      "data_format": "XML/JSON",
      "parameters": ["location", "severity", "type"]
    },
    "road_status": {
      "provider": "Road.is",
      "endpoint": "https://www.road.is/travel-info/road-conditions-and-weather/",
      "update_frequency": "实时",
      "data_format": "JSON",
      "critical_info": ["开放/关闭状态", "路况", "天气条件"]
    },
    "volcano_alerts": {
      "provider": "Icelandic Met Office",
      "endpoint": "https://en.vedur.is/earthquakes-and-volcanism/",
      "update_frequency": "实时",
      "alert_levels": ["绿色", "黄色", "橙色", "红色"]
    }
  },
  "alert_templates": {
    "weather_alert_template": {
      "alert_id": "WA-{timestamp}-{location}",
      "alert_type": "weather",
      "severity": "critical|severe|moderate|advisory",
      "region": "区域名称",
      "event_type": "暴风雪|强风|冰雨|雾|极端低温",
      "start_time": "ISO 8601格式",
      "end_time": "ISO 8601格式",
      "description_zh": "中文描述",
      "description_en": "English description",
      "affected_routes": ["route_id_001", "route_id_002"],
      "recommendations": [
        "推荐行动1",
        "推荐行动2"
      ],
      "source": "Icelandic Met Office",
      "last_updated": "ISO 8601格式"
    },
