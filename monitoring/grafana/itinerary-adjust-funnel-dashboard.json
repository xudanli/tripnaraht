      "id": 201,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "sum(rate(tripnara_itinerary_adjust_funnel_total{stage=\"draft_created\"}[5m])) by (sub_intent, execution_mode)",
          "legendFormat": "draft {{sub_intent}}/{{execution_mode}}",
          "refId": "A"
        },
        {
          "expr": "sum(rate(tripnara_itinerary_adjust_funnel_total{stage=\"apply_clicked\"}[5m]))",
          "legendFormat": "apply_clicked",
          "refId": "B"
        }
      ],
      "title": "草案创建 vs 用户点击 Apply",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.75 }
            ]
          },
          "unit": "percentunit"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 202,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "sum(rate(tripnara_itinerary_adjust_funnel_total{stage=~\"auto_apply|user_apply\", outcome=\"success\"}[1h])) / sum(rate(tripnara_itinerary_adjust_funnel_total{stage=~\"auto_apply|user_apply\"}[1h]))",
          "legendFormat": "apply success rate (1h)",
          "refId": "A"
        }
      ],
      "title": "落库成功率（自动 + 手动）",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 203,
      "targets": [
        {
          "expr": "sum(rate(tripnara_itinerary_adjust_funnel_total{stage=\"auto_apply\", outcome=\"success\"}[5m])) by (execution_mode, sub_intent)",
          "legendFormat": "auto {{execution_mode}}/{{sub_intent}}",
          "refId": "A"
        }
      ],
      "title": "自动落库成功（AUTO / SEMI_AUTO）",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 204,
      "targets": [
        {
          "expr": "topk(8, sum(rate(tripnara_itinerary_adjust_funnel_total{outcome=\"failure\"}[1h])) by (stage, reason))",
