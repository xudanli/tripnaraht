          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n  date_trunc('day', created_at AT TIME ZONE 'UTC') AS time,\n  SUM(cost_usd)::double precision AS cost_usd\nFROM llm_token_logs\nWHERE $__timeFilter(created_at)\nGROUP BY 1\nORDER BY 1",
          "refId": "A"
        }
