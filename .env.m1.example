# M1 local topology (allowed as Staging)

M1_TOPOLOGY=local
# Skip Redis when no local Redis available (Apply/OCC/LB still proven on shared PG)
M1_LOCAL_SKIP_REDIS=1

# Prefer real local Redis when available:
# REDIS_URL=redis://127.0.0.1:6379
# UWC_1E_SESSION_REDIS=1
# M1_LOCAL_SKIP_REDIS=0

CONFIRM_MULTI_INSTANCE_LIVE=1
UWC_ITINERARY_CANARY_AUTHORIZED=1
UWC_ITINERARY_CANARY_PERCENT=100
UWC_ITINERARY_CANARY_OP_ALLOWLIST=same_day_time_adjust,same_day_add_item,same_day_add_from_candidates

# Boot everything:
#   npm run m1:local-staging
